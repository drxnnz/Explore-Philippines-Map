    /** True when province name equals capital (NCR cities, Pateros, etc.) */
    function isCityUnit(item) {
      if (!item) return false;
      const p = (item.p || "").trim().toLowerCase();
      const c = (item.c || "").trim().toLowerCase();
      return p.length > 0 && p === c;
