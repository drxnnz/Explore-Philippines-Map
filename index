    function prepareGuessRegionQueue() {
      // Always use nationwide pool so the correct region is one of many
      const pool = getAllItems(null);
      let qs = pool.map((it) => {
        if (isCityUnit(it)) {
          return { ...it, mode: "city" };
        }
        // Random province vs capital per item (no alternating pattern)
        return {
          ...it,
          mode: Math.random() < 0.5 ? "province" : "capital"
        };
      });
      // Always randomize order so the quiz isn't predictable
      return shuffle(qs);
    }

