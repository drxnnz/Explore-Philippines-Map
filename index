    /** Build multiple-choice region options based on difficulty (easy/normal/hard/speedrun) */
    function buildGuessRegionButtons(correctCode) {
      const grid = document.getElementById("guess-region-grid");
      if (!grid) return;
      grid.innerHTML = "";

      const nChoices = GUESS_DIFF_CHOICES[guessDiff] || 3;
      const allCodes = Object.keys(REGIONS);
      let choices = [];
      if (correctCode && REGIONS[correctCode]) {
        choices.push(correctCode);
        const others = shuffle(allCodes.filter(c => c !== correctCode));
        for (const c of others) {
          if (choices.length >= nChoices) break;
          choices.push(c);
        }
      } else {
        choices = shuffle(allCodes).slice(0, nChoices);
      }
      choices = shuffle(choices);

      const row = document.createElement("div");
      row.className = "guess-island-row guess-choices-row cols-" + nChoices;
      for (const code of choices) {
        const reg = REGIONS[code];
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "region-btn";
        btn.dataset.code = code;
        btn.innerHTML = `<span class="code">${code}</span><span class="name">${(reg && reg.name) || code}</span>`;
        btn.onclick = () => submitGuessRegion(code);
        row.appendChild(btn);
      }
      grid.appendChild(row);
    }

