            document.getElementById("q-text").textContent = item.c;
          }
        }
        setTimeout(() => typeInput && typeInput.focus(), 80);
      }
    }

    function haversine(lat1, lon1, lat2, lon2) {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLon = (lon2 - lon1) * Math.PI / 180;
      const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLon/2)**2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    /**
     * Spread label positions so nearby names don't stack on top of each other.
     * Returns [{lat, lng, ...item}] with adjusted coords; keeps original as _origLat/_origLng.
     */
    function spreadLabelPositions(items, opts) {
      const o = opts || {};
      const minSepKm = o.minSepKm != null ? o.minSepKm : 2.8;
      const iterations = o.iterations || 28;
      const strength = o.strength != null ? o.strength : 0.55;
      if (!items || items.length < 2) {
        return (items || []).map(it => ({
          ...it,
          _origLat: it.lat,
          _origLng: it.lng
        }));
      }
      const pts = items.map((it, i) => ({
        ...it,
        _origLat: it.lat,
        _origLng: it.lng,
        lat: it.lat,
        lng: it.lng,
        _i: i
      }));
      // Prefer denser areas (NCR) get slightly stronger separation
      const dens = pts.length >= 10 ? 1.25 : 1;
      for (let iter = 0; iter < iterations; iter++) {
        for (let i = 0; i < pts.length; i++) {
          let fx = 0, fy = 0;
          for (let j = 0; j < pts.length; j++) {
            if (i === j) continue;
            const dKm = haversine(pts[i].lat, pts[i].lng, pts[j].lat, pts[j].lng);
            const need = minSepKm * dens;
            if (dKm >= need || dKm < 0.001) continue;
            // Push apart proportionally to how much they overlap
            const push = ((need - dKm) / need) * strength;
            let dLat = pts[i].lat - pts[j].lat;
            let dLng = pts[i].lng - pts[j].lng;
            const len = Math.sqrt(dLat * dLat + dLng * dLng) || 0.0001;
            dLat /= len;
            dLng /= len;
            // ~1 km ≈ 0.009 deg lat; scale push
            const step = push * 0.012;
            fy += dLat * step;
            fx += dLng * step;
          }
          // Soft spring back toward original so labels stay near their province
          const back = 0.18;
          fy += (pts[i]._origLat - pts[i].lat) * back;
          fx += (pts[i]._origLng - pts[i].lng) * back;
          pts[i].lat += fy;
          pts[i].lng += fx;
        }
      }
      // Final micro-offset spiral for any remaining near-duplicates
      for (let i = 0; i < pts.length; i++) {
        for (let j = 0; j < i; j++) {
          const dKm = haversine(pts[i].lat, pts[i].lng, pts[j].lat, pts[j].lng);
          if (dKm >= minSepKm * 0.55) continue;
          const angle = (i * 2.4 + j) % (Math.PI * 2);
          const r = 0.018 + (i % 5) * 0.004;
          pts[i].lat += Math.sin(angle) * r;
          pts[i].lng += Math.cos(angle) * r;
        }
      }
      return pts;
    }

    function placeAnswerLabel(item, correct) {
      if (!map) return;
      const stateCls = correct ? "label-ok" : "label-miss";
      // Deconflict against already-placed answer labels
      const existing = (keptMarkers || []).map(m => {
        const ll = m.getLatLng && m.getLatLng();
        return ll ? { lat: ll.lat, lng: ll.lng } : null;
      }).filter(Boolean);
      let lat = item.lat, lng = item.lng;
      if (existing.length) {
        const trial = spreadLabelPositions(
          [...existing.map((e, i) => ({ ...e, p: "x" + i })), { ...item, lat, lng }],
          { minSepKm: currentCode === "NCR" ? 1.6 : 3.2, iterations: 18 }
        );
        const last = trial[trial.length - 1];
        if (last) { lat = last.lat; lng = last.lng; }
      }
      const html = `<div class="label-marker label-answered label-just ${stateCls}">${item.p}<div class="cap">${item.c}</div></div>`;
      const icon = L.divIcon({
        className: "ph-label-icon",
        html: html,
        iconSize: undefined,
        iconAnchor: [0, 12]
      });
      const marker = L.marker([lat, lng], {
        icon,
        interactive: false,
        opacity: 1,
        zIndexOffset: correct ? 200 : 100
      }).addTo(map);
      keptMarkers.push(marker);
      setTimeout(() => {
        const el = marker.getElement && marker.getElement();
        if (!el) return;
        const label = el.querySelector(".label-marker");
        if (label) label.classList.remove("label-just");
        if (marker.setZIndexOffset) marker.setZIndexOffset(0);
      }, 900);
    }

    function onMapClick(e, item) {
      if (answered || appMode !== "pin") return;
      answered = true;
      map.off("click", clickHandler);

      const clickLat = e.latlng.lat;
      const clickLng = e.latlng.lng;

      const feat = findFeatureForProvince(item.p);
      // Soft hit zone for tiny islands (Batanes, Camiguin, etc.) - phone-friendly
      let inside = isClickCorrectForProvince(clickLng, clickLat, feat, item);
      if (!feat && !inside) {
        const dist = haversine(clickLat, clickLng, item.lat, item.lng);
        const tol = currentCode === "NCR" ? (isCoarsePointer() ? 8 : 5) : getClickToleranceKm(item, null);
        inside = dist < tol;
      }

      const userIcon = L.divIcon({
        className: "",
        html: `<div style="background:${inside ? "#22c55e" : "#ef4444"};width:12px;height:12px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 0 0 3px ${inside ? "rgba(34,197,94,0.35)" : "rgba(239,68,68,0.35)"},0 2px 8px rgba(0,0,0,0.45)"></div>`,
        iconSize: [12,12], iconAnchor: [6,6]
      });
      markers.push(L.marker([clickLat, clickLng], { icon: userIcon }).addTo(map));

      placeAnswerLabel(item, inside);

      // Highlight answered province; keep every other province dark
      styleQuizBordersAfterAnswer(item.p, inside);

      if (!inside) {
        const line = L.polyline([[clickLat, clickLng], [item.lat, item.lng]], {
          color: "#a3a3a3", weight: 2, dashArray: "6 6"
        }).addTo(map);
        markers.push(line);
      }

      let pts = 0, cls = "bad", msg = "";
      if (inside) {
        pts = 1;
        cls = "ok";
        msg = `Correct! Inside the border of ${item.p}. +1`;
        if (typeof sfxCorrect === "function") sfxCorrect();
      } else {
        pts = 0;
        cls = "bad";
        msg = `Outside the border of ${item.p}. Capital: ${item.c}`;
        if (typeof sfxWrong === "function") sfxWrong();
      }
      score += pts;
      if (pts === 0) missed.push({ name: item.p, capital: item.c });

      document.getElementById("score").textContent = score;
      const bar = document.getElementById("result-bar");
      bar.className = `result-bar show ${cls}`;
      document.getElementById("result-msg").textContent = msg;

      if ((pts === 1 && settings.autoNext) || (pts === 0 && settings.autoNextWrong)) {
        document.getElementById("next-btn").style.display = "none";
        maybeAutoNext(pts === 1);
      } else {
        document.getElementById("next-btn").style.display = "inline-block";
      }
    }

    function answersMatch(user, expected) {
      const u = normName(user);
      const e = normName(expected);
      if (!u || !e) return false;
      if (u === e) return true;
      const strip = s => s.replace(/\b(city|sta|santa|san|del|de|del sur|del norte)\b/g, "").replace(/\s+/g, " ").trim();
      if (strip(u) === strip(e) && strip(u).length > 2) return true;
      if (e.includes(u) && u.length >= Math.min(5, e.length - 2)) return true;
      return false;
    }

    function submitType() {
      if (answered || appMode !== "type") return;
      const item = queue[idx];
      const input = document.getElementById("type-input");
      const raw = (input.value || "").trim();
      if (!raw) { input.focus(); return; }
      answered = true;
      pendingTargetHighlight = null;
      input.disabled = true;

      // city unit (p === c): expect the city name once
      // province mode: type the capital
      // capital mode: type the province
      let expected;
      if (item.mode === "city" || isCityUnit(item)) expected = item.p;
      else if (item.mode === "province") expected = item.c;
      else expected = item.p;
      const ok = answersMatch(raw, expected);

      placeAnswerLabel(item, ok);
      if (map) map.panTo([item.lat, item.lng], { animate: true });

      // Highlight answered province; keep every other province dark
      styleQuizBordersAfterAnswer(item.p, ok);

      let pts = 0, cls = "bad", msg = "";
      const cityQ = item.mode === "city" || isCityUnit(item);
      if (ok) {
        pts = 1;
        cls = "ok";
        input.className = "type-input right";
        msg = cityQ ? `Correct! ${item.p}. +1` : `Correct! ${item.p} → ${item.c}. +1`;
        if (typeof sfxCorrect === "function") sfxCorrect();
      } else {
        pts = 0;
        cls = "bad";
        input.className = "type-input wrong";
        msg = cityQ
          ? `Not quite. Answer: ${expected}`
          : `Not quite. Answer: ${expected} (${item.p} / ${item.c})`;
        missed.push({ name: item.p, capital: item.c });
        if (typeof sfxWrong === "function") sfxWrong();
      }
      score += pts;
      document.getElementById("score").textContent = score;
      const bar = document.getElementById("result-bar");
      bar.className = `result-bar show ${cls}`;
      document.getElementById("result-msg").textContent = msg;

      if ((pts === 1 && settings.autoNext) || (pts === 0 && settings.autoNextWrong)) {
        document.getElementById("next-btn").style.display = "none";
        maybeAutoNext(pts === 1);
      } else {
        document.getElementById("next-btn").style.display = "inline-block";
      }
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { if (typeof closeAvatarZoom==="function") closeAvatarZoom(); closeSettings(); if (typeof closeAbout==="function") closeAbout(); if (typeof closeSurprisePicker==="function") closeSurprisePicker(); if (typeof dismissWelcome==="function") dismissWelcome(true); }
      if (e.key === "Enter" && appMode === "type" &&
          document.getElementById("screen-quiz").classList.contains("active") &&
          !answered) {
        submitType();
      }
      if (e.key === "Enter" && appMode === "guess_region" &&
          document.getElementById("screen-quiz").classList.contains("active") &&
          !answered) {
        submitGuessRegionType();
      }
      if (e.key === "Enter" && appMode === "marathon" &&
          document.getElementById("screen-quiz").classList.contains("active")) {
        e.preventDefault();
        submitMarathon();
      }
    });

    function nextQ() {
      clearAutoNext();
      idx++;
      showQ();
    }

    function showResults(timedOut) {
      clearAllQuizMarks();
      clearAutoNext();
      // Freeze leftover time for carry, then stop the ticking timer
      const leftover = (playStyle === "speedrun" && !timedOut) ? Math.max(0, timerLeft) : 0;
      stopTimer();
      const badge = document.getElementById("timer-badge");
      if (badge) badge.style.display = "none";

      const rl = document.getElementById("results-label");
      if (rl) rl.textContent = timedOut ? "Time is up!" : "Finished!";
      // Marathon: remaining items count as not guessed for the review list
      if (appMode === "marathon" && quizState.remaining && quizState.remaining.length) {
        missed = quizState.remaining.map(it => ({ name: it.p, capital: it.c }));
        score = quizState.guessedCount || score;
        if ((!queue || !queue.length) && quizState.totalTargets) {
          queue = new Array(quizState.totalTargets);
        }
      }
      const totalQ = (queue && queue.length) ? queue.length : (quizState.totalTargets || 0);
      const correctN = score || 0;
      const missN = Math.max(0, totalQ - correctN);
      document.getElementById("final-score").textContent = `${correctN}/${totalQ}`;
      const pct = totalQ ? Math.round(correctN / totalQ * 100) : 0;
      let t = timedOut ? "Speedrun ended" : pct === 100 ? "Perfect!" : pct >= 80 ? "Strong recall!" : pct >= 60 ? "Good - a bit more practice" : "Review the ones you missed";
      document.getElementById("final-pct").textContent = `${pct}% - ${t}`;

      const bd = document.getElementById("score-breakdown");
      if (bd) {
        bd.innerHTML =
          `<span class="score-chip ok">✓ ${correctN} correct</span>` +
          `<span class="score-chip miss">✗ ${missN} missed</span>` +
          `<span class="score-chip pct">${pct}%</span>`;
      }

      const box = document.getElementById("missed-box");
      if (missed.length) {
        box.innerHTML =
          `<div class="review-missed-box">` +
          `<h4>Review - missed / not guessed</h4>` +
          `<ul>` +
          missed.map(m => {
            const name = m.name || m.p || "";
            const cap = m.capital || m.c || "";
            return `<li><strong>${name}</strong>${cap ? `<span class="cap-hint">Capital: ${cap}</span>` : ""}</li>`;
          }).join("") +
          `</ul></div>`;
      } else if (totalQ > 0 && correctN >= totalQ) {
        box.innerHTML = `<p class="results-perfect">Perfect run - nothing to review 🎉</p>`;
      } else {
        box.innerHTML = "";
      }

      const prompt = document.getElementById("speedrun-next-prompt");
      const promptLabel = document.getElementById("speedrun-next-label");
      const promptReady = document.getElementById("speedrun-next-ready");
      if (prompt) prompt.style.display = "none";

      const nextBtn = document.getElementById("btn-next-region");
      if (nextBtn) {
        if (playStyle === "speedrun") {
          nextBtn.style.display = "none";
          const info = typeof getNextNavInfo === "function" ? getNextNavInfo() : null;
          // Auto-next only if time remains AND option is on - show scoreboard first, then countdown
          if (settings.speedrunAutoNext && !timedOut && leftover > 0 && info && info.code) {
            speedrunCarrySeconds = leftover;
            const carry = leftover;
            const nextName = info.isNextIsland
              ? (info.nextIsland || info.label)
              : ((REGIONS[info.code] && REGIONS[info.code].name) || info.code);
            const nextTitle = info.isNextIsland
              ? ("Next island: " + nextName)
              : ("Next region: " + info.code + " - " + nextName);
            const cdSecs = settings.countdown || 3;
            if (prompt && promptLabel && promptReady) {
              prompt.style.display = "block";
              promptLabel.textContent = nextTitle;
              promptReady.textContent = "Be ready - the next region will begin in " + cdSecs + "s";
            }
            // Let user read the scoreboard briefly, then full-screen countdown
            if (speedrunNextTimeout) clearTimeout(speedrunNextTimeout);
            speedrunNextTimeout = setTimeout(() => {
              speedrunNextTimeout = null;
              if (playStyle !== "speedrun") return;
              runCountdown(() => {
                if (playStyle !== "speedrun") return;
                cleanupMaps();
                currentCode = info.code;
                reviewQuizAllowed = true;
                speedrunCarrySeconds = carry;
                startQuiz();
              }, {
                title: nextTitle,
                sub: "Be ready - the next region will begin in " + cdSecs + "s",
                subTemplate: "Be ready - the next region will begin in {n}s",
                seconds: cdSecs
              });
            }, 1400);
          } else if (!timedOut && info && info.code && currentCode) {
            nextBtn.style.display = "inline-block";
            nextBtn.textContent = info.isNextIsland
              ? ("Next island → " + (info.nextIsland || info.label))
              : ("Next region → " + info.code);
          }
        } else {
          const info = typeof getNextNavInfo === "function" ? getNextNavInfo() : null;
          if (info && info.code && currentCode) {
            nextBtn.style.display = "inline-block";
            nextBtn.textContent = info.isNextIsland
              ? ("Next island → " + (info.nextIsland || info.label))
              : ("Next region → " + info.code);
          } else {
            nextBtn.style.display = "none";
          }
        }
      }
      // Auto-save score history every finished quiz
      try {
        const totalQ = queue.length || 0;
        if (totalQ > 0) {
          const regionLabel = currentCode
            ? `${currentCode} - ${(REGIONS[currentCode] && REGIONS[currentCode].name) || currentCode}`
            : "Whole Philippines Map";
          const missList = (missed || []).map(m => ({
            name: m.name || m.p || "",
            capital: m.capital || m.c || ""
          }));
          pushHistoryEntry({
            id: Date.now(),
            at: new Date().toISOString(),
            mode: appMode || "pin",
            playStyle: playStyle || "normal",
            region: currentCode || "ALL",
            regionLabel,
            score: score || 0,
            correct: score || 0,
            total: totalQ,
            pct,
            timedOut: !!timedOut,
            missedCount: missList.length,
            missed: missList
          });
        }
      } catch (err) {
        try { console.warn("history save failed", err); } catch (_) {}
      }
      show("results");
    }


    const GCASH_NUMBER = "09245220812";
    function copyGcash() {
      const n = GCASH_NUMBER;
      const done = () => {
        const h = document.getElementById("gcash-hint");
        if (h) {
          h.textContent = "Copied · " + n;
          setTimeout(() => { h.textContent = "Tap to copy number"; }, 2000);
        }
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(n).then(done).catch(() => {
          try {
            const ta = document.createElement("textarea");
            ta.value = n; document.body.appendChild(ta); ta.select();
            document.execCommand("copy"); document.body.removeChild(ta);
