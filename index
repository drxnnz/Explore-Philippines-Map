<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Explore Philippines Map</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/topojson-client@3/dist/topojson-client.min.js"></script>
  <script src="data/ph-topo.js"></script>
  <style>
    :root, [data-theme="dark"] {
      --bg: #050505;
      --bg2: #0a0a0a;
      --card: #111111;
      --card2: #161616;
      --elev: #1a1a1a;
      --accent: #e8e8e8;
      --accent-soft: rgba(255,255,255,0.08);
      --good: #4ade80;
      --bad: #f87171;
      --warn: #fbbf24;
      --text: #f5f5f5;
      --muted: #a3a3a3;
      --faint: #737373;
      --border: #262626;
      --border-strong: #404040;
      --radius: 12px;
      --shadow: 0 12px 40px rgba(0,0,0,0.65), 0 2px 8px rgba(0,0,0,0.4);
      --shadow-card: 0 4px 24px rgba(0,0,0,0.45);
      --map-bg: #0a0a0a;
      --input-bg: #0a0a0a;
      --hero-grad: linear-gradient(105deg, #fafafa 0%, #a3a3a3 100%);
      --neon: #f5f5f5;
      --neon-soft: rgba(255, 255, 255, 0.14);
      --neon-glow: 0 0 18px rgba(255, 255, 255, 0.18);
      --trans: 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    [data-theme="light"] {
      --bg: #eef0f3;
      --bg2: #e2e5ea;
      --card: #ffffff;
      --card2: #f8f9fb;
      --elev: #ffffff;
      --accent: #18181b;
      --accent-soft: rgba(0,0,0,0.05);
      --good: #16a34a;
      --bad: #dc2626;
      --warn: #d97706;
      --text: #09090b;
      --muted: #3f3f46;
      --faint: #71717a;
      --border: #d4d8de;
      --border-strong: #b8bec8;
      --shadow: 0 16px 48px rgba(15, 23, 42, 0.14), 0 6px 16px rgba(15, 23, 42, 0.08);
      --shadow-card: 0 8px 28px rgba(15, 23, 42, 0.12), 0 2px 8px rgba(15, 23, 42, 0.06);
      --map-bg: #dfe3e8;
      --input-bg: #f8f9fb;
      --hero-grad: linear-gradient(105deg, #0f172a 0%, #334155 100%);
      --neon: #0f172a;
      --neon-soft: rgba(15, 23, 42, 0.12);
      --neon-glow: 0 0 18px rgba(15, 23, 42, 0.16);
      --trans: 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    /* Remove yellow/blue tap highlight & focus ring on Android / mobile */
    html, body, button, a, input, select, textarea, div, span, label,
    .leaflet-container, .leaflet-pane, .leaflet-interactive, .leaflet-marker-icon {
      -webkit-tap-highlight-color: transparent;
      -webkit-touch-callout: none;
    }
    button, a, .mode-card, .region-btn, .nav-btn, .icon-btn, .btn,
    .leaflet-container, .leaflet-interactive {
      outline: none;
      -webkit-tap-highlight-color: transparent;
    }
    button:focus, a:focus, .mode-card:focus, .region-btn:focus,
    .nav-btn:focus, .icon-btn:focus, .btn:focus {
      outline: none;
      box-shadow: none;
    }
    /* Keep keyboard focus only (desktop), never yellow mobile ring */
    button:focus:not(:focus-visible),
    a:focus:not(:focus-visible),
    .mode-card:focus:not(:focus-visible),
    .region-btn:focus:not(:focus-visible),
    .nav-btn:focus:not(:focus-visible),
    .icon-btn:focus:not(:focus-visible),
    .btn:focus:not(:focus-visible) {
      outline: none;
      box-shadow: none;
    }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.45;
      transition: background 0.4s cubic-bezier(0.4, 0, 0.2, 1), color 0.35s ease, border-color 0.35s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .container { max-width: 1080px; margin: 0 auto; padding: 1rem 1.1rem 2.5rem; }

    /* Header bar */
    .app-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 0.85rem;
      position: sticky;
      top: 0;
      z-index: 8000;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      margin: 0 -1.1rem 0.55rem;
      width: calc(100% + 2.2rem);
      box-sizing: border-box;
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.28s ease,
                  box-shadow 0.28s ease;
      will-change: transform, opacity;
    }
    /* Android / touch: hide on scroll down, show on scroll up */
    .app-header.nav-hidden {
      transform: translateY(-110%);
      opacity: 0;
      pointer-events: none;
      box-shadow: none;
    }
    .app-header.nav-show-fast {
      transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.18s ease,
                  box-shadow 0.2s ease;
    }
    .app-header.nav-hide-smooth {
      transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.32s ease,
                  box-shadow 0.32s ease;
    }
    .app-header-left, .app-header-right {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      min-width: 0;
    }
    .app-header-right { margin-left: auto; }
    .nav-btn {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text);
      height: 36px;
      padding: 0 0.75rem;
      border-radius: 10px;
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      gap: 0.3rem;
      font-size: 0.82rem;
      font-weight: 650;
      font-family: inherit;
      white-space: nowrap;
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
                  border-color 0.28s ease,
                  background 0.28s ease,
                  box-shadow 0.3s ease;
    }
    .nav-btn.show { display: inline-flex; }
    .nav-btn:hover {
      border-color: var(--neon);
      background: var(--elev);
      box-shadow: var(--neon-glow);
    }
    .nav-btn:active { transform: scale(0.97); }
    .history-panel {
      max-width: 440px;
      max-height: min(90vh, 680px);
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 1.4rem 1.35rem 1.25rem;
    }
    .history-panel h3 { margin-bottom: 0.35rem; }
    .history-sub {
      font-size: 0.8rem;
      color: var(--faint);
      margin: 0 0 1rem;
      line-height: 1.45;
    }
    .history-list {
      overflow-y: auto;
      flex: 1;
      min-height: 140px;
      max-height: min(54vh, 440px);
      margin: 0;
      padding: 0.15rem 0.1rem 0.35rem;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      -webkit-overflow-scrolling: touch;
    }
    .history-empty {
      text-align: center;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.55;
      padding: 2rem 1rem;
      border: 1px dashed var(--border-strong);
      border-radius: 14px;
      background: var(--accent-soft);
    }
    .history-card {
      background: var(--elev);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1rem 1.05rem;
      box-shadow: var(--shadow-card);
      opacity: 0;
      transform: translateY(10px);
      animation: historyCardIn 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes historyCardIn {
      to { opacity: 1; transform: translateY(0); }
    }
    .history-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.85rem;
    }
    .history-region {
      font-weight: 700;
      font-size: 0.94rem;
      color: var(--text);
      letter-spacing: -0.01em;
      line-height: 1.3;
    }
    .history-meta {
      font-size: 0.74rem;
      color: var(--faint);
      margin-top: 0.3rem;
      line-height: 1.45;
    }
    .history-score {
      font-weight: 800;
      font-size: 1.12rem;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      letter-spacing: -0.02em;
    }
    .history-score.good { color: var(--good); }
    .history-score.mid { color: var(--warn); }
    .history-score.bad { color: var(--bad); }
    .history-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.75rem;
    }
    .history-chip {
      font-size: 0.72rem;
      font-weight: 650;
      padding: 0.28rem 0.58rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--accent-soft);
      color: var(--muted);
    }
    .history-chip.ok {
      color: var(--good);
      border-color: color-mix(in srgb, var(--good) 35%, var(--border));
      background: color-mix(in srgb, var(--good) 10%, transparent);
    }
    .history-chip.miss {
      color: var(--bad);
      border-color: color-mix(in srgb, var(--bad) 35%, var(--border));
      background: color-mix(in srgb, var(--bad) 10%, transparent);
    }
    .history-missed {
      margin-top: 0.75rem;
      padding-top: 0.65rem;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--muted);
    }
    .history-missed strong {
      display: block;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--faint);
      margin-bottom: 0.35rem;
    }
    .history-missed li {
      list-style: none;
      padding: 0.28rem 0;
      border-bottom: 1px solid var(--border);
      line-height: 1.4;
    }
    .history-missed li:last-child { border-bottom: none; }
    .history-actions {
      display: flex;
      gap: 0.6rem;
      margin-top: 1.1rem;
      padding-top: 0.15rem;
    }
    .history-actions .btn { flex: 1; }
    .icon-btn {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text);
      width: 40px;
      height: 40px;
      border-radius: 10px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
                  border-color 0.28s ease,
                  background 0.28s ease,
                  box-shadow 0.3s ease;
    }
    .icon-btn:hover {
      border-color: var(--neon);
      background: var(--elev);
      box-shadow: var(--neon-glow);
    }

    /* Settings panel */
    .settings-overlay {
      display: flex;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 9000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.32s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0.32s cubic-bezier(0.4, 0, 0.2, 1);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
    .settings-overlay.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    .settings-panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.35rem 1.4rem;
      width: 100%;
      max-width: 360px;
      box-shadow: var(--shadow);
      transform: translateY(16px) scale(0.96);
      opacity: 0;
      transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .settings-overlay.open .settings-panel {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
    .settings-panel h3 {
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 1.1rem;
      letter-spacing: -0.01em;
    }
    .setting-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
    }
    .setting-row:last-of-type { border-bottom: none; }
    .setting-row label {
      font-size: 0.9rem;
      color: var(--text);
    }
    .setting-row .hint {
      display: block;
      font-size: 0.75rem;
      color: var(--faint);
      margin-top: 0.15rem;
    }
    .toggle {
      position: relative;
      width: 44px;
      height: 24px;
      flex-shrink: 0;
    }
    .toggle input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
      position: absolute;
      inset: 0;
      background: var(--border-strong);
      border-radius: 999px;
      cursor: pointer;
      transition: 0.2s;
    }
    .toggle-slider::before {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      left: 3px;
      top: 3px;
      background: #fff;
      border-radius: 50%;
      transition: 0.2s;
    }
    .toggle input:checked + .toggle-slider {
      background: var(--text);
    }
    [data-theme="light"] .toggle input:checked + .toggle-slider {
      background: #171717;
    }
    .toggle input:checked + .toggle-slider::before {
      transform: translateX(20px);
      background: var(--bg);
    }
    .settings-close {
      margin-top: 1rem;
      width: 100%;
    }

    /* Home */
    .hero {
      text-align: center;
      padding: 1.4rem 0 1rem;
    }
    .hero-badge {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      background: var(--accent-soft);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.28rem 0.85rem;
      margin-bottom: 0.75rem;
      transition: border-color 0.3s ease, background 0.3s ease, color 0.3s ease;
    }
    .hero h1 {
      font-size: clamp(1.7rem, 5vw, 2.35rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      background: var(--hero-grad);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.45rem;
    }
    .hero p {
      color: var(--muted);
      font-size: clamp(0.9rem, 2.5vw, 1.02rem);
      max-width: 500px;
      margin: 0 auto;
    }

    .mode-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 0.9rem;
      margin: 1.4rem 0 1.75rem;
    }
    .mode-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.2rem 1.15rem;
      cursor: pointer;
      text-align: left;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.35s ease,
                  border-color 0.3s ease,
                  background 0.3s ease;
      color: inherit;
      width: 100%;
      font: inherit;
      box-shadow: var(--shadow-card);
    }
    .mode-card:hover, .mode-card:focus {
      border-color: var(--neon);
      background: var(--elev);
      transform: translateY(-3px);
      box-shadow: var(--shadow), var(--neon-glow);
      outline: none;
    }
    .mode-icon { font-size: 1.55rem; margin-bottom: 0.55rem; display: block; }
    .mode-card h3 {
      font-size: 1.08rem;
      font-weight: 700;
      margin-bottom: 0.3rem;
      color: var(--text);
    }
    .mode-card p {
      font-size: 0.86rem;
      color: var(--muted);
      margin-bottom: 0.8rem;
    }
    .mode-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
    .tag {
      font-size: 0.68rem;
      color: var(--muted);
      background: var(--accent-soft);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 0.16rem 0.42rem;
    }

    /* About modal + creator credit */
    .about-overlay {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9200;
      background: rgba(0,0,0,0.62);
      align-items: center;
      justify-content: center;
      padding: 1rem;
      opacity: 0;
      transition: opacity 0.38s cubic-bezier(0.4, 0, 0.2, 1);
      backdrop-filter: blur(5px);
      -webkit-backdrop-filter: blur(5px);
    }
    .about-overlay.open {
      display: flex;
      opacity: 1;
    }
    .about-panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.35rem 1.3rem 1.25rem;
      width: 100%;
      max-width: 400px;
      box-shadow: var(--shadow);
      transform: translateY(16px) scale(0.96);
      opacity: 0.96;
      transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.38s ease;
      max-height: min(88vh, 640px);
      overflow-y: auto;
    }
    .about-overlay.open .about-panel {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
    .about-panel h3 {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--faint);
      margin-bottom: 1rem;
    }
    .about-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .about-avatar {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border-strong);
      box-shadow: 0 0 0 3px var(--accent-soft), var(--shadow-card);
      flex-shrink: 0;
      background: var(--elev);
      user-select: none;
      -webkit-user-drag: none;
      cursor: zoom-in;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.4s ease,
                  border-color 0.35s ease,
                  filter 0.35s ease;
    }
    .about-avatar:hover {
      transform: scale(1.07);
      box-shadow: 0 0 0 4px var(--accent-soft), var(--neon-glow), var(--shadow);
      filter: brightness(1.04);
    }
    .avatar-lightbox {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 9500;
      background: rgba(0,0,0,0);
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1),
                  background 0.42s ease,
                  visibility 0.42s;
      cursor: zoom-out;
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
    }
    .avatar-lightbox.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      background: rgba(0,0,0,0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
    .avatar-lightbox img {
      width: min(340px, 80vw);
      height: min(340px, 80vw);
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.28);
      box-shadow: 0 28px 72px rgba(0,0,0,0.6), 0 0 0 1px var(--neon-soft), 0 0 40px rgba(255,255,255,0.08);
      transform: scale(0.72) translateY(18px);
      opacity: 0;
      transition: transform 0.52s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.45s ease,
                  box-shadow 0.45s ease;
    }
    .avatar-lightbox.open img {
      transform: scale(1) translateY(0);
      opacity: 1;
      animation: avatarPop 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes avatarPop {
      0% { transform: scale(0.72) translateY(18px); opacity: 0; filter: blur(4px); }
      60% { transform: scale(1.04) translateY(-2px); opacity: 1; filter: blur(0); }
      100% { transform: scale(1) translateY(0); opacity: 1; filter: blur(0); }
    }
    .about-meta { min-width: 0; flex: 1; }
    .about-name { font-weight: 700; font-size: 1.08rem; color: var(--text); }
    .about-aff { font-size: 0.8rem; color: var(--muted); margin-top: 0.2rem; line-height: 1.4; }
    .about-links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 0.95rem;
      width: 100%;
      max-width: 280px;
    }
    .about-link {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.65rem;
      width: 100%;
      max-width: 280px;
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text);
      text-decoration: none;
      background: var(--elev);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.72rem 1rem;
      transition: background 0.32s ease, border-color 0.32s ease, color 0.32s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.32s ease;
      box-sizing: border-box;
      text-align: left;
    }
    .about-link svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      fill: currentColor;
      stroke: currentColor;
      transition: fill 0.25s ease, stroke 0.25s ease;
    }
    .about-link:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 18px rgba(0,0,0,0.28);
    }
    [data-theme="dark"] .about-link.email:hover,
    [data-theme="dark"] .about-link.email:focus,
    [data-theme="dark"] .about-link.fb:hover,
    [data-theme="dark"] .about-link.fb:focus {
      background: #f5f5f5;
      border-color: #f5f5f5;
      color: #0a0a0a;
      box-shadow: 0 8px 28px rgba(255,255,255,0.18);
    }
    [data-theme="light"] .about-link.email:hover,
    [data-theme="light"] .about-link.email:focus,
    [data-theme="light"] .about-link.fb:hover,
    [data-theme="light"] .about-link.fb:focus {
      background: #18181b;
      border-color: #18181b;
      color: #fafafa;
      box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    }
    .about-link:active {
      transform: translateY(0) scale(0.98);
    }
    .about-quote {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      font-style: italic;
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.55;
    }
    .about-panel-close {
      margin-top: 1.1rem;
      width: 100%;
    }

    /* Creator credit footer */
    .creator-credit {
      margin: 1.75rem 0 0.35rem;
      padding-top: 1.1rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.65rem;
      text-align: center;
      transition: opacity 0.4s ease, gap 0.35s ease, padding 0.35s ease;
    }
    .credit-name, .credit-aff {
      transition: color 0.35s ease, font-size 0.35s ease, opacity 0.35s ease;
    }
    .creator-credit.home-mode .credit-photo-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.55rem;
    }
    .creator-credit:not(.home-mode) .credit-photo-wrap {
      display: none;
    }
    .credit-avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border-strong);
      box-shadow: 0 0 0 3px var(--accent-soft);
      cursor: zoom-in;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.4s ease,
                  filter 0.35s ease,
                  opacity 0.35s ease;
      user-select: none;
      -webkit-user-drag: none;
      background: var(--elev);
    }
    .credit-avatar:hover {
      transform: scale(1.08);
      box-shadow: 0 0 0 3px var(--accent-soft), var(--neon-glow);
      filter: brightness(1.05);
    }
    .credit-photo-wrap {
      transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), max-height 0.4s ease;
    }
    .creator-credit.home-mode .credit-photo-wrap {
      animation: creditIn 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes creditIn {
      from { opacity: 0; transform: translateY(8px) scale(0.94); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .credit-text {
      line-height: 1.4;
    }
    .credit-name {
      font-weight: 650;
      font-size: 0.88rem;
      color: var(--text);
      letter-spacing: -0.01em;
    }
    .credit-aff {
      font-size: 0.72rem;
      color: var(--faint);
      margin-top: 0.12rem;
    }
    .creator-credit:not(.home-mode) .credit-name {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--muted);
    }
    .creator-credit:not(.home-mode) .credit-aff {
      font-size: 0.68rem;
      color: var(--faint);
      opacity: 0.9;
    }
    .btn-about-me {
      display: none;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      margin-top: 0.15rem;
      padding: 0.48rem 1rem;
      font-size: 0.78rem;
      font-weight: 650;
      font-family: inherit;
      color: var(--text);
      background: var(--accent-soft);
      border: 1px solid var(--border);
      border-radius: 999px;
      cursor: pointer;
      transition: border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease, transform 0.15s ease;
    }
    .creator-credit.home-mode .btn-about-me { display: inline-flex; }
    .btn-about-me:hover {
      border-color: var(--neon);
      box-shadow: var(--neon-glow);
      background: var(--elev);
      transform: translateY(-1px);
    }
    .btn-about-me:active { transform: translateY(0) scale(0.98); }

    /* Screens */
    .screen { display: none; opacity: 0; transform: translateY(12px); }
    .screen.active { display: block; animation: screenIn 0.48s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
    @keyframes screenIn {
      from { opacity: 0; transform: translateY(16px) scale(0.985); filter: blur(2px); }
      to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }
    @keyframes fadeInSoft {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeOutSoft {
      from { opacity: 1; }
      to { opacity: 0; }
    }
    .mode-card, .region-group, .play-options, .prompt-box, .results-card {
      animation: fadeInSoft 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .mode-grid .mode-card:nth-child(1) { animation-delay: 0.04s; }
    .mode-grid .mode-card:nth-child(2) { animation-delay: 0.1s; }
    .mode-grid .mode-card:nth-child(3) { animation-delay: 0.16s; }
    .result-bar.show { animation: fadeInSoft 0.35s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .map-pick-btn {
      animation: fadeInSoft 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .topbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 0.85rem;
    }
    .topbar h2 {
      font-size: clamp(1.02rem, 3vw, 1.2rem);
      color: var(--text);
      font-weight: 700;
    }
    .stats { font-size: 0.86rem; color: var(--muted); }
    .stats strong { color: var(--text); }

    .prompt-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.85rem 1rem;
      margin-bottom: 0.65rem;
      text-align: center;
    }
    .prompt-box .label {
      font-size: 0.7rem;
      color: var(--faint);
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }
    .prompt-box .q {
      font-size: clamp(1.12rem, 3.5vw, 1.35rem);
      font-weight: 700;
      margin-top: 0.2rem;
    }

    #map, #map-review {
      height: min(52vh, 520px);
      min-height: 280px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--map-bg);
      width: 100%;
    }
    .map-review-wrap {
      position: relative;
      width: 100%;
      border-radius: 12px;
      overflow: hidden;
    }
    .map-review-wrap #map-review {
      border-radius: 12px;
    }
    /* Island picks - above Next region / Back (below the map) */
    .map-island-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.45rem;
      margin: 0.65rem 0 0.35rem;
      padding: 0 0.15rem;
      animation: fadeSlideUp 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    /* legacy class kept for any leftover refs */
    .map-island-overlay { display: none; }
    .map-island-fab {
      pointer-events: auto;
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.1rem;
      padding: 0.5rem 0.95rem;
      border-radius: 14px;
      border: 1.5px solid rgba(255,255,255,0.5);
      background: rgba(12, 12, 12, 0.9);
      color: #f5f5f5;
      font-family: inherit;
      font-weight: 800;
      font-size: 0.88rem;
      letter-spacing: -0.01em;
      cursor: pointer;
      box-shadow: 0 8px 28px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.06);
      transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.22s ease,
                  background 0.22s ease,
                  border-color 0.22s ease,
                  opacity 0.35s ease,
                  filter 0.35s ease;
      -webkit-tap-highlight-color: transparent;
      white-space: nowrap;
      line-height: 1.15;
      user-select: none;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .map-island-fab .fab-sub {
      font-size: 0.64rem;
      font-weight: 600;
      color: #a3a3a3;
    }
    .map-island-fab:hover {
      transform: translateY(-2px) scale(1.04);
      border-color: #fff;
      box-shadow: 0 10px 32px rgba(0,0,0,0.5), 0 0 16px rgba(255,255,255,0.18);
    }
    .map-island-fab:active { transform: scale(0.97); }
    .map-island-fab.active {
      background: #f5f5f5;
      color: #0a0a0a;
      border-color: #f5f5f5;
      box-shadow: 0 0 0 2px rgba(255,255,255,0.35), 0 8px 28px rgba(0,0,0,0.4);
    }
    .map-island-fab.active .fab-sub { color: #525252; }
    .map-island-fab.dimmed {
      opacity: 0.42;
      filter: saturate(0.4) brightness(0.85);
    }
    [data-theme="light"] .map-island-fab {
      background: rgba(255,255,255,0.94);
      color: #0a0a0a;
      border-color: rgba(0,0,0,0.16);
      box-shadow: 0 8px 24px rgba(15,23,42,0.18);
    }
    [data-theme="light"] .map-island-fab .fab-sub { color: #71717a; }
    [data-theme="light"] .map-island-fab.active {
      background: #18181b;
      color: #fafafa;
      border-color: #18181b;
    }
    [data-theme="light"] .map-island-fab.active .fab-sub { color: #a1a1aa; }
    [data-theme="light"] .map-island-fab.dimmed {
      opacity: 0.38;
      filter: saturate(0.5) brightness(1.05);
    }
    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .map-pick-btn.region-pick.faded {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: scale(0.92);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }
    /* PC / desktop only: taller map so whole country / region fits clearly */
    @media (hover: hover) and (pointer: fine) and (min-width: 900px) {
      .container { max-width: 1200px; }
      #map, #map-review {
        height: min(74vh, 720px);
        min-height: 480px;
      }
    }
    .leaflet-container { background: var(--map-bg) !important; }
    /* Hide Leaflet chrome */
    .leaflet-control-zoom,
    .leaflet-control-attribution,
    .leaflet-bottom.leaflet-right,
    .leaflet-bottom.leaflet-left { display: none !important; }

    .result-bar {
      display: flex;
      margin-top: 0.6rem;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      font-size: 0.9rem;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      padding-top: 0;
      padding-bottom: 0;
      border: 1px solid transparent;
      transform: translateY(8px);
      transition: opacity 0.32s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
                  max-height 0.35s ease,
                  padding 0.3s ease,
                  border-color 0.3s ease,
                  background 0.3s ease;
      pointer-events: none;
    }
    .result-bar.show {
      max-height: 120px;
      opacity: 1;
      padding: 0.75rem 1rem;
      transform: translateY(0);
      pointer-events: auto;
    }
    .result-bar.ok {
      background: rgba(74,222,128,0.1);
      border: 1px solid rgba(74,222,128,0.35);
      color: var(--good);
    }
    .result-bar.bad {
      background: rgba(248,113,113,0.1);
      border: 1px solid rgba(248,113,113,0.3);
      color: var(--bad);
    }

    .actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
      margin-top: 0.85rem;
    }
    .actions .btn {
      width: 100%;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-sizing: border-box;
    }
    /* When only one primary action is visible, let it span full width if alone */
    .actions .btn[style*="display: none"] { display: none !important; }
    @media (min-width: 520px) {
      .actions {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
      .actions.actions-center {
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        max-width: 640px;
        margin-left: auto;
        margin-right: auto;
      }
    }
    .btn {
      border: none;
      border-radius: 11px;
      padding: 0.72rem 1rem;
      font-weight: 650;
      font-size: 0.88rem;
      line-height: 1.25;
      cursor: pointer;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.25s ease,
                  box-shadow 0.3s ease,
                  background 0.3s ease,
                  border-color 0.25s ease,
                  color 0.25s ease;
      -webkit-tap-highlight-color: transparent;
      font-family: inherit;
      white-space: nowrap;
    }
    .btn-primary {
      background: var(--text);
      color: var(--bg);
    }
    .btn-primary:hover {
      opacity: 0.92;
      box-shadow: var(--neon-glow);
    }
    .btn-primary:disabled { opacity: 0.35; cursor: not-allowed; }
    .btn-sec {
      background: var(--card);
      border: 1px solid var(--border);
      color: var(--text);
    }
    .btn-sec:hover { border-color: var(--border-strong); background: var(--elev); }
    .btn-ghost {
      background: var(--accent-soft);
      border: 1px solid var(--border);
      color: var(--text);
    }
    .btn-ghost:hover { background: var(--elev); border-color: var(--border-strong); }

    .region-grid {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .region-group {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: var(--shadow-card);
    }
    .region-group-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: 100%;
      padding: 0.85rem 1rem;
      background: var(--elev);
      border: none;
      border-bottom: 1px solid transparent;
      color: var(--text);
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: background 0.25s ease, border-color 0.25s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .region-group.open .region-group-head {
      border-bottom-color: var(--border);
    }
    .region-group-head:hover,
    .region-group-head:active {
      background: var(--card2);
    }
    .region-group-title {
      display: flex;
      flex-direction: column;
      gap: 0.12rem;
      min-width: 0;
    }
    .region-group-title .grp-name {
      font-weight: 750;
      font-size: 0.95rem;
      letter-spacing: -0.01em;
    }
    .region-group-title .grp-meta {
      font-size: 0.72rem;
      color: var(--faint);
      font-weight: 500;
    }
    .region-group-chevron {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--accent-soft);
      border: 1px solid var(--border);
      color: var(--muted);
      font-size: 0.78rem;
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
                  color 0.25s ease,
                  border-color 0.25s ease;
    }
    .region-group.open .region-group-chevron {
      transform: rotate(180deg);
      color: var(--text);
      border-color: var(--border-strong);
    }
    .region-group-body {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
      gap: 0.5rem;
      padding: 0;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      transition: max-height 0.38s cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 0.28s ease,
                  padding 0.28s ease;
    }
    .region-group.open .region-group-body {
      max-height: 1200px;
      opacity: 1;
      padding: 0.7rem 0.75rem 0.85rem;
    }
    .group-label {
      display: none;
    }
    .region-btn {
      background: var(--card2);
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 0.75rem 0.8rem;
      color: var(--text);
      cursor: pointer;
      text-align: left;
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
                  background 0.28s ease,
                  border-color 0.28s ease,
                  box-shadow 0.28s ease;
      width: 100%;
      min-height: 56px;
      font: inherit;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .region-btn:hover, .region-btn:focus {
      border-color: var(--border-strong);
      background: var(--elev);
      transform: translateY(-1px);
      outline: none;
    }
    .region-btn.whole {
      background: var(--elev);
      border-color: var(--border-strong);
      text-align: center;
      padding: 0.95rem;
      border-radius: 14px;
      box-shadow: var(--shadow-card);
    }
    .region-btn .code { font-weight: 700; color: var(--text); display: block; }
    .region-btn .name { font-size: 0.78rem; color: var(--muted); }

    /* Review Map - island group dropdown */
    .review-island-bar {
      display: none; /* island picks live on the map */
    }
    .review-show-all-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.55rem;
      margin: 0 0 0.55rem;
      padding: 0.1rem 0.05rem;
    }
    .review-show-all-row label {
      font-size: 0.8rem;
      font-weight: 650;
      color: var(--muted);
      cursor: pointer;
      user-select: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
    }
    .review-show-all-row input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--text);
      cursor: pointer;
    }
    .review-island-btn {
      flex: 1;
      min-width: 90px;
      padding: 0.55rem 0.7rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--muted);
      font-size: 0.84rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: background 0.22s ease, border-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .review-island-btn:hover {
      border-color: var(--border-strong);
      color: var(--text);
      background: var(--elev);
    }
    .review-island-btn.active {
      background: var(--text);
      color: var(--bg);
      border-color: var(--text);
      box-shadow: var(--neon-glow);
    }
    /* On-map island / region pickers */
    .map-pick-btn {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.12rem;
      padding: 0.55rem 0.85rem;
      border-radius: 12px;
      border: 1.5px solid rgba(255,255,255,0.55);
      background: rgba(10, 10, 10, 0.88);
      color: #f5f5f5;
      font-family: inherit;
      font-weight: 800;
      font-size: 0.92rem;
      letter-spacing: -0.01em;
      cursor: pointer;
      box-shadow: 0 6px 22px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.08);
      transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
                  box-shadow 0.22s ease,
                  background 0.22s ease,
                  border-color 0.22s ease,
                  opacity 0.35s ease,
                  filter 0.35s ease;
      -webkit-tap-highlight-color: transparent;
      white-space: nowrap;
      line-height: 1.15;
      pointer-events: auto;
      user-select: none;
    }
    .map-pick-btn .sub {
      font-size: 0.68rem;
      font-weight: 600;
      color: #a3a3a3;
      letter-spacing: 0.02em;
    }
    .map-pick-btn:hover {
      transform: scale(1.06);
      border-color: #fff;
      box-shadow: 0 8px 28px rgba(0,0,0,0.5), 0 0 18px rgba(255,255,255,0.2);
    }
    .map-pick-btn:active { transform: scale(0.97); }
    .map-pick-btn.active {
      background: #f5f5f5;
      color: #0a0a0a;
      border-color: #f5f5f5;
      box-shadow: 0 0 0 2px rgba(255,255,255,0.35), 0 8px 28px rgba(0,0,0,0.4);
    }
    .map-pick-btn.active .sub { color: #525252; }
    .map-pick-btn.dimmed {
      opacity: 0.38;
      filter: saturate(0.45) brightness(0.8);
      /* still clickable so user can switch island */
    }
    .map-pick-btn.region-pick {
      padding: 0.42rem 0.65rem;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 750;
      background: rgba(15, 15, 15, 0.9);
      border-color: rgba(255,255,255,0.4);
    }
    .map-pick-btn.region-pick .sub {
      font-size: 0.62rem;
      max-width: 110px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .map-pick-btn.region-pick.active {
      background: #f5f5f5;
      color: #0a0a0a;
    }
    [data-theme="light"] .map-pick-btn {
      background: rgba(255,255,255,0.94);
      color: #0a0a0a;
      border-color: rgba(0,0,0,0.18);
