    let welcomeTimer = null;
    const WELCOME_HIDE_KEY = "pmm-welcome-hide-v1";

    function readWelcomeHide() {
      try {
        if (localStorage.getItem(WELCOME_HIDE_KEY) === "1") return true;
      } catch (_) {}
      try {
        if (sessionStorage.getItem(WELCOME_HIDE_KEY) === "1") return true;
      } catch (_) {}
      // cookie fallback (helps some Android WebView / content:// cases)
      try {
        if (/(?:^|; )pmm-welcome-hide-v1=1(?:;|$)/.test(document.cookie || "")) return true;
      } catch (_) {}
      return false;
    }

    function writeWelcomeHide() {
      try { localStorage.setItem(WELCOME_HIDE_KEY, "1"); } catch (_) {}
      try { sessionStorage.setItem(WELCOME_HIDE_KEY, "1"); } catch (_) {}
      try {
        const exp = new Date();
        exp.setFullYear(exp.getFullYear() + 2);
        document.cookie = "pmm-welcome-hide-v1=1; expires=" + exp.toUTCString() + "; path=/; SameSite=Lax";
      } catch (_) {}
    }

    function shouldShowWelcome() {
      return !readWelcomeHide();
    }

    function persistDontShowIfChecked() {
      const dont = document.getElementById("welcome-dont-show");
      if (dont && dont.checked) writeWelcomeHide();
    }

    function dismissWelcome(fromButton) {
      const ov = document.getElementById("welcome-overlay");
      if (!ov) return;
      // Always honor checkbox on any dismiss path (Got it / auto-timer / Escape)
      persistDontShowIfChecked();
      if (welcomeTimer) { clearTimeout(welcomeTimer); welcomeTimer = null; }
      ov.classList.add("closing");
      ov.classList.remove("open");
      setTimeout(() => {
        ov.classList.remove("closing");
        ov.style.display = "none";
      }, 450);
    }

    function showWelcomeIfNeeded() {
      if (!shouldShowWelcome()) return;
      const ov = document.getElementById("welcome-overlay");
      if (!ov) return;
      ov.style.display = "";
      const bar = document.getElementById("welcome-bar");
      if (bar) {
        bar.style.animation = "none";
        void bar.offsetWidth;
        bar.style.animation = "";
      }
      // Bind checkbox so preference saves immediately when toggled
      const dont = document.getElementById("welcome-dont-show");
      if (dont && !dont._boundHide) {
        dont._boundHide = true;
        dont.addEventListener("change", function () {
          if (dont.checked) writeWelcomeHide();
        });
      }
      ov.classList.remove("closing");
      ov.classList.add("open");
      if (welcomeTimer) clearTimeout(welcomeTimer);
      welcomeTimer = setTimeout(() => dismissWelcome(false), 5000);
    }
    window.dismissWelcome = dismissWelcome;
    window.showWelcomeIfNeeded = showWelcomeIfNeeded;

    // Boot welcome after short paint
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => setTimeout(showWelcomeIfNeeded, 350));
    } else {
      setTimeout(showWelcomeIfNeeded, 350);
    }

