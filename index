      if (appMode === "marathon") return; // marathon is free-type, no per-question flow
      if (idx >= queue.length) {
        showResults();
        return;
      }
      answered = false;
      clearTempMarkers();
      clearAutoNext();
      // Reset province fills to dim between questions (answered ones stay labeled via markers)
      resetQuizBordersDim();
      const item = queue[idx];
