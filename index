    function submitMarathon() {
      if (appMode !== "marathon") return;
      const input = document.getElementById("marathon-input");
      const raw = (input && input.value || "").trim();
      if (!raw) {
        if (input) input.focus();
        return;
      }
      const fb = document.getElementById("marathon-feedback");

      const already = (quizState.guessedList || []).find(it =>
        answersMatch(raw, it.p) || answersMatch(raw, it.c)
      );
      if (already) {
        if (fb) {
          fb.className = "bad";
          fb.textContent = "Already guessed: " + already.p + " → " + already.c;
        }
        if (input) { input.value = ""; input.focus(); }
        return;
      }

      const match = quizState.remaining.find(it =>
        answersMatch(raw, it.p) || answersMatch(raw, it.c)
      );

      if (!match) {
        if (fb) {
          fb.className = "bad";
          fb.textContent = "No match - try another name";
        }
        if (typeof sfxWrong === "function") sfxWrong();
        if (input) input.select();
        return;
      }

      quizState.remaining = quizState.remaining.filter(x => x !== match);
      if (!quizState.guessedList) quizState.guessedList = [];
      quizState.guessedList.push(match);
      quizState.guessedCount += 1;
      score = quizState.guessedCount;
      updateMarathonProgress();

      placeAnswerLabel(match, true);
      if (typeof styleQuizBordersAfterAnswer === "function") {
        try { styleQuizBordersAfterAnswer(match.p, true); } catch (_) {}
      }
      if (map) map.panTo([match.lat, match.lng], { animate: true, duration: 0.35 });

      if (fb) {
        fb.className = "ok";
        fb.textContent = "✓ " + match.p + " → " + match.c + " (" + match.regionCode + ")";
      }
      if (typeof sfxCorrect === "function") sfxCorrect();

      if (input) {
        input.value = "";
        input.focus();
      }

      if (quizState.remaining.length === 0) {
        missed = [];
        idx = quizState.totalTargets;
        score = quizState.guessedCount;
        try { clearAllQuizMarks(); } catch (_) {}
        showResults(false);
      }
    }

