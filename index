      if (!raw) { if (input) input.focus(); return; }
      const item = queue[idx];
      const ok = matchRegionAnswer(raw, item.regionCode);
      // Resolve which code they meant if possible for button highlight
      let picked = null;
      if (ok) picked = item.regionCode;
      else {
        const u = raw.toLowerCase();
        for (const code of Object.keys(REGIONS)) {
          if (matchRegionAnswer(raw, code)) { picked = code; break; }
        }
