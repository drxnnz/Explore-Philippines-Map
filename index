    function matchRegionAnswer(raw, correctCode) {
      const u = (raw || "").trim().toLowerCase().replace(/\s+/g, " ");
      if (!u) return false;
      const code = (correctCode || "").toLowerCase();
      const reg = REGIONS[correctCode];
      const name = ((reg && reg.name) || "").toLowerCase();
      if (u === code) return true;
      if (name && (u === name || name.includes(u) || u.includes(name))) return true;
      // common aliases
      const aliases = {
        ncr: ["ncr", "national capital region", "metro manila", "metromanila"],
        car: ["car", "cordillera", "cordillera administrative region"],
        barmm: ["barmm", "bangsamoro", "armm"],
        "iv-a": ["iv-a", "iva", "calabarzon", "region 4a", "region iv-a"],
        "iv-b": ["iv-b", "ivb", "mimaropa", "region 4b", "region iv-b"],
        i: ["i", "ilocos", "ilocos region", "region 1", "region i"],
        ii: ["ii", "cagayan valley", "region 2", "region ii"],
        iii: ["iii", "central luzon", "region 3", "region iii"],
        v: ["v", "bicol", "bicol region", "region 5", "region v"],
        vi: ["vi", "western visayas", "region 6", "region vi"],
        vii: ["vii", "central visayas", "region 7", "region vii"],
        viii: ["viii", "eastern visayas", "region 8", "region viii"],
        ix: ["ix", "zamboanga peninsula", "region 9", "region ix"],
        x: ["x", "northern mindanao", "region 10", "region x"],
        xi: ["xi", "davao", "davao region", "region 11", "region xi"],
        xii: ["xii", "soccsksargen", "region 12", "region xii"],
        xiii: ["xiii", "caraga", "region 13", "region xiii"]
      };
      const list = aliases[code] || [];
      return list.some(a => a === u || u.includes(a) || a.includes(u));
    }

