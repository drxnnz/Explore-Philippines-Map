          document.getElementById("q-label").textContent = "Name this city";
          document.getElementById("q-text").textContent = "(orange area on the map)";
          pendingTargetHighlight = item.p;
          styleQuizBordersHighlightTarget(item.p);
          // Borders may still be loading — retry a few times
          let tries = 0;
          const retry = () => {
            if (answered || pendingTargetHighlight !== item.p) return;
            const ok = styleQuizBordersHighlightTarget(item.p);
            if (!ok && tries < 12) {
              tries++;
              setTimeout(retry, 200);
