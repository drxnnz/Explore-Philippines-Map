    // Android / touch only: sticky top bar auto-hide
    // - scroll top→bottom: hide (smooth fade)
    // - scroll bottom→top: show (snappy + smooth fade in)
    // PC / mouse: always visible
    (function initMobileNavScroll() {
      const header = document.getElementById("app-header");
      if (!header) return;
      let lastY = window.scrollY || 0;
      let ticking = false;
      const THRESH = 10;

      function isTouchUI() {
        try {
          return !!(window.matchMedia && (
            window.matchMedia("(pointer: coarse)").matches ||
            window.matchMedia("(max-width: 900px)").matches
          ));
        } catch (e) {
          return window.innerWidth <= 900;
        }
      }

      function onScrollAndroid() {
        if (!isTouchUI()) {
          header.classList.remove("nav-hidden", "nav-show-fast", "nav-hide-smooth");
          lastY = window.scrollY || 0;
          return;
        }
        const y = window.scrollY || 0;
        const dy = y - lastY;
        if (Math.abs(dy) < THRESH) {
          lastY = y;
          return;
        }
        if (y <= 16) {
          header.classList.remove("nav-hidden", "nav-show-fast");
          header.classList.add("nav-hide-smooth");
        } else if (dy > 0) {
          // top → bottom: hide with smooth fade
          header.classList.remove("nav-show-fast");
          header.classList.add("nav-hide-smooth");
          header.classList.add("nav-hidden");
        } else {
          // bottom → top: show quickly with fade-in
          header.classList.remove("nav-hide-smooth");
          header.classList.add("nav-show-fast");
          header.classList.remove("nav-hidden");
        }
        lastY = y;
      }

      window.addEventListener("scroll", () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          onScrollAndroid();
          ticking = false;
        });
      }, { passive: true });
    })();

