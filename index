          b.innerHTML = `<span class="code">${code}</span><span class="name">${r.name}</span>`;
          b.onclick = () => startRegion(code);
          body.appendChild(b);
        });

        head.onclick = () => {
          const isOpen = wrap.classList.toggle("open");
          window._openRegionGroups[grp.label] = isOpen;
          head.setAttribute("aria-expanded", isOpen ? "true" : "false");
          const meta = head.querySelector(".grp-meta");
          if (meta) {
            meta.textContent = `${count} region${count === 1 ? "" : "s"} · tap to ${isOpen ? "collapse" : "expand"}`;
          }
        };

        wrap.appendChild(head);
        wrap.appendChild(body);
        g.appendChild(wrap);
      });
    }

    function getItemsForCode(code) {
      if (!code) {
        const all = [];
        Object.values(REGIONS).forEach(r => r.items.forEach(it => all.push({ ...it })));
        return all;
      }
      return REGIONS[code].items.map(it => ({ ...it }));
    }

    function getBoundsForCode(code) {
      return code ? REGIONS[code].bounds : PH_BOUNDS;
    }

    /** Island group currently open in Review Map panel (null = closed). */
    let reviewOpenIsland = null;
    /** Track if Start Quiz should stay visible when jumping regions from review panel. */
    let reviewQuizAllowed = true;
    /**
     * Review map name labels:
     * - Default UNCHECKED: show province/city/capital names for current region/island
     * - CHECKED: hide all those names; uncheck → they come back
     */
    let reviewHideAllNames = false;
    const reviewRevealedNames = new Set();
    /** Island whose labels are currently shown on review map (null = none / whole PH unlabeled). */
    let reviewActiveIsland = null;
    /** true when review is showing a single region (not whole island / whole PH). */
    let reviewShowingRegion = false;

    function getGroupByLabel(label) {
      return GROUPS.find(g => g.label === label) || null;
    }

    function getIslandBounds(label) {
      // Tight professional frames - avoid drifting into open Pacific
      const TIGHT = {
        Luzon: [[12.95, 119.55], [18.75, 122.55]],
        Visayas: [[8.95, 121.55], [12.55, 125.35]],
        Mindanao: [[5.35, 121.55], [10.15, 126.35]]
      };
      if (TIGHT[label]) return TIGHT[label];
      const grp = getGroupByLabel(label);
      if (!grp) return PH_BOUNDS;
      let minLat = 90, minLng = 180, maxLat = -90, maxLng = -180;
      grp.codes.forEach(code => {
        const b = REGIONS[code] && REGIONS[code].bounds;
        if (!b) return;
        minLat = Math.min(minLat, b[0][0]);
        minLng = Math.min(minLng, b[0][1]);
        maxLat = Math.max(maxLat, b[1][0]);
        maxLng = Math.max(maxLng, b[1][1]);
      });
      // Slight inward pad so camera doesn't float over open ocean
      const padLat = (maxLat - minLat) * 0.04;
      const padLng = (maxLng - minLng) * 0.04;
      return [[minLat + padLat * 0.3, minLng + padLng], [maxLat - padLat * 0.2, maxLng - padLng]];
    }

    function getItemsForIsland(label) {
      const grp = getGroupByLabel(label);
      if (!grp) return getItemsForCode(null);
      const all = [];
      grp.codes.forEach(code => {
        const r = REGIONS[code];
        if (!r) return;
        r.items.forEach(it => all.push({ ...it }));
      });
      return all;
    }

    function setReviewIslandButtons(activeLabel) {
      document.querySelectorAll(".review-island-btn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.island === activeLabel);
      });
      // Fixed overlay FABs — also respect Hide all names
      const bar = document.getElementById("map-island-overlay");
      if (bar) bar.style.display = reviewHideAllNames ? "none" : "";
      document.querySelectorAll(".map-island-fab").forEach(btn => {
        const isActive = btn.dataset.island === activeLabel;
        const isDim = !!activeLabel && !isActive;
        btn.classList.toggle("active", isActive);
        btn.classList.toggle("dimmed", isDim);
      });
    }

    function closeReviewIslandPanel() {
      reviewOpenIsland = null;
      setReviewIslandButtons(null);
      const panel = document.getElementById("review-region-panel");
      if (panel) panel.hidden = true;
    }

    function openReviewIslandPanel(label) {
      const grp = getGroupByLabel(label);
      if (!grp) return;
      reviewOpenIsland = label;
      setReviewIslandButtons(label);

      const panel = document.getElementById("review-region-panel");
      const titleEl = document.getElementById("review-region-panel-title");
      const list = document.getElementById("review-region-list");
      if (!panel || !list) return;

      if (titleEl) titleEl.textContent = label + " regions";
      list.innerHTML = "";

      // Regions only (no "All Luzon" - island button already means that group)
      grp.codes.forEach(code => {
        const r = REGIONS[code];
        if (!r) return;
        const b = document.createElement("button");
        b.type = "button";
        b.className = "review-region-chip" + (currentCode === code ? " active" : "");
        b.innerHTML = `<span class="code">${code}</span><span class="name">${r.name}</span>`;
        b.onclick = () => jumpToReviewRegion(code);
        list.appendChild(b);
      });

      panel.hidden = false;
    }

    function syncHideNamesCheckbox() {
      const el = document.getElementById("tog-hide-all-names");
      if (el) el.checked = !!reviewHideAllNames;
    }
    // Legacy alias used in a few call sites
    function syncShowAllCheckbox() { syncHideNamesCheckbox(); }

    function clearReviewLabelsOnly() {
      if (reviewMarkers && reviewMarkers.length) {
        reviewMarkers.forEach(m => {
          try { if (mapReview) mapReview.removeLayer(m); } catch (e) {}
        });
      }
      reviewMarkers = [];
      reviewFocusIdx = -1;
      reviewClickLocked = false;
      reviewHoverIdx = -1;
      reviewLockedIdx = -1;
    }

    const REVIEW_PROVINCE_ZOOM = 8.4;

    /** Province/city names when a region is open and Hide is off */
    function getReviewLabelItems(scopeItems) {
      if (reviewHideAllNames) return [];
      if (!(reviewShowingRegion && currentCode)) return [];
      const pool = (scopeItems && scopeItems.length)
        ? scopeItems
        : getItemsForCode(currentCode);
      return pool.slice();
    }

    function provinceNameFromFeature(feature) {
      if (!feature || !feature.properties) return null;
      const p = feature.properties;
      return p.adm2_en || p.name || p.NAME_2 || p.province || null;
    }

    /** True if a region code is allowed under current island/region scope */
    function isReviewCodeInScope(code) {
      if (!code) return false;
      // Specific region open → only that region
      if (reviewShowingRegion && currentCode) return code === currentCode;
      // Island selected (Luzon/Visayas/Mindanao) → only that island's regions
      if (reviewActiveIsland) {
        const isl = codeToIsland(code);
        return isl === reviewActiveIsland;
      }
      // No island filter → whole PH free
      return true;
    }

    /** Find province feature under latlng, scoped to active island/region when set */
    function findReviewProvinceAt(latlng) {
      if (!mapReview || !latlng) return null;
      const lng = latlng.lng, lat = latlng.lat;
      let found = null;
      let foundCode = null;
      const walk = (layer, codeHint) => {
        if (found || !layer) return;
        if (layer.eachLayer) {
          layer.eachLayer(ly => walk(ly, codeHint || layer._phCode));
          return;
        }
        if (!layer.feature) return;
        const code = codeHint || layer._phCode || null;
        // When island/region is active, ignore out-of-scope borders
        if (code && !isReviewCodeInScope(code)) return;
        if (pointInFeature(lng, lat, layer.feature)) {
          // Double-check by resolving name → item → region
          const nm = provinceNameFromFeature(layer.feature);
          if (nm && (reviewActiveIsland || (reviewShowingRegion && currentCode))) {
            const it = resolveReviewItemScoped(nm);
            if (!it) return; // out of scope
          }
          found = layer.feature;
          foundCode = code;
        }
      };
      if (borderLayerReview) walk(borderLayerReview, null);
      if (typeof reviewBorderByCode !== "undefined" && reviewBorderByCode) {
        Object.keys(reviewBorderByCode).forEach(code => {
          if (!found && isReviewCodeInScope(code)) walk(reviewBorderByCode[code], code);
        });
      }
      return found;
    }

    /** Resolve name only within active island / region scope */
    function resolveReviewItemScoped(name) {
      if (!name) return null;
      const key = String(name).trim();
      let pool;
      if (reviewShowingRegion && currentCode) {
        pool = getItemsForCode(currentCode);
      } else if (reviewActiveIsland) {
        pool = getItemsForIsland(reviewActiveIsland);
      } else {
        pool = getAllItems(null);
      }
      return pool.find(it =>
        it.p === key || it.c === key ||
        featureMatchesProvince({ name: it.p, adm2_en: it.p }, key) ||
        featureMatchesProvince({ name: it.c, adm2_en: it.c }, key)
      ) || null;
    }

    /** Temporary focus label (hover / tap) — hides again when unfocused */
    let reviewFocusItem = null;

    function resolveReviewItem(name) {
      // Prefer scoped resolve; free mode still searches all
      const scoped = resolveReviewItemScoped(name);
      if (scoped) return scoped;
      if (reviewActiveIsland || (reviewShowingRegion && currentCode)) return null;
      const key = String(name).trim();
      return getAllItems(null).find(it =>
        it.p === key || it.c === key ||
        featureMatchesProvince({ name: it.p, adm2_en: it.p }, key)
      ) || null;
    }

    function clearReviewFocusLabel() {
      reviewFocusItem = null;
      _reviewHoverName = null;
      // Remove only the temporary focus marker (keep zoom-level labels)
      if (reviewMarkers && reviewMarkers.length) {
        const keep = [];
        reviewMarkers.forEach(m => {
          if (m._isFocusOnly) {
            try { if (mapReview) mapReview.removeLayer(m); } catch (e) {}
          } else {
            keep.push(m);
          }
        });
        reviewMarkers = keep;
      }
      if (!reviewClickLocked) {
        styleReviewProvinceFocus(null);
        setReviewFocus(-1);
      }
    }

    function showReviewFocusLabel(item, opts) {
      if (!item || !mapReview) return;
      reviewFocusItem = item;
      styleReviewProvinceFocus(item.p);

      // If this name is already among zoom labels, just focus it
      let idx = (reviewMarkers || []).findIndex(m => m._phItem && m._phItem.p === item.p);
      if (idx >= 0) {
        setReviewFocus(idx);
      } else {
        // Temporary single label (focus only)
        const icon = L.divIcon({
          className: "ph-label-icon",
          html: makeLabelHtml(item, true),
          iconSize: undefined,
          iconAnchor: [0, 12]
        });
        const marker = L.marker([item.lat, item.lng], {
          icon, interactive: true, riseOnHover: true, opacity: 1, zIndexOffset: 1200
        }).addTo(mapReview);
        marker._phItem = item;
        marker._isFocusOnly = true;
        // Drop previous focus-only markers
        reviewMarkers = (reviewMarkers || []).filter(m => {
          if (m._isFocusOnly && m !== marker) {
            try { mapReview.removeLayer(m); } catch (e) {}
            return false;
          }
          return true;
        });
        reviewMarkers.push(marker);
        idx = reviewMarkers.length - 1;
        setReviewFocus(idx);
      }

      if (opts && opts.zoom) {
        flyReviewToPlace(item.lat, item.lng);
      }
    }

    /**
     * Auto-focus pan/zoom on a tapped place.
     * Cap auto-zoom so repeated taps don't dig deeper — manual pinch/scroll stays free.
     */
    const REVIEW_AUTO_ZOOM_MAX = 9.4;
    const REVIEW_AUTO_ZOOM_MIN = 8.6;
    function flyReviewToPlace(lat, lng) {
      if (!mapReview || lat == null || lng == null) return;
      const cur = mapReview.getZoom() || 8;
      // Already at or past auto cap → pan only (same zoom), never dig deeper
      const z = cur >= REVIEW_AUTO_ZOOM_MAX
        ? cur
        : Math.min(Math.max(cur + 0.35, REVIEW_AUTO_ZOOM_MIN), REVIEW_AUTO_ZOOM_MAX);
      mapReview.flyTo([lat, lng], z, { duration: 0.65, easeLinearity: 0.28 });
    }

    function revealReviewProvince(name, opts) {
      const item = resolveReviewItem(name);
      if (!item) return;
      showReviewFocusLabel(item, opts);
    }

    /**
     * Province labels:
     * - Hide all names ON → never (only temporary focus)
     * - Region selected → always show that region's names
     * - Manual zoom close enough → show names for current scope (region / island / all)
     */
    const REVIEW_NAMES_ZOOM = 9.0;
    function syncReviewLabelsByZoom() {
      if (!mapReview) return;
      const focus = reviewFocusItem;

      if (reviewHideAllNames) {
        // Hide all names → no mass labels even on close zoom
        clearReviewLabelsOnly();
        if (focus) showReviewFocusLabel(focus);
        return;
      }

      const z = mapReview.getZoom() || 0;
      let items = [];

      if (reviewShowingRegion && currentCode) {
        // Region open → province names always
        items = getItemsForCode(currentCode);
      } else if (z >= REVIEW_NAMES_ZOOM) {
        // Manual zoom close → show province names for scope
        if (reviewActiveIsland) {
          items = getItemsForIsland(reviewActiveIsland);
        } else {
          // Whole PH free + zoomed in: only show if very close (avoid flood)
          // Prefer nothing at PH scale; user can pick island/region
          items = z >= 9.6 ? getAllItems(null) : [];
        }
      }

      clearReviewLabelsOnly();
      if (items.length) {
        attachReviewMarkers(items, items.length > 12);
      }
      if (focus) {
        const idx = (reviewMarkers || []).findIndex(m => m._phItem && m._phItem.p === focus.p);
        if (idx >= 0) setReviewFocus(idx);
        else showReviewFocusLabel(focus);
      }
    }

    function refreshReviewRevealedLabels() {
      syncReviewLabelsByZoom();
    }

    function onReviewMapClick(e) {
      if (!mapReview) return;
      const feat = findReviewProvinceAt(e.latlng);
      if (feat) {
        const name = provinceNameFromFeature(feat);
        // Scoped: if island/region is active, ignore out-of-scope hits
        if (name && resolveReviewItem(name)) {
          revealReviewProvince(name, { zoom: true });
          if (e.originalEvent) L.DomEvent.stopPropagation(e.originalEvent);
          return;
        }
      }
      // Tap empty / out-of-scope → drop focus, hierarchical zoom-back
      clearReviewFocusLabel();
      onReviewEmptyClick();
    }

    let _reviewHoverName = null;
    let _reviewHoverTimer = null;
    function onReviewMapMouseMove(e) {
      if (!mapReview) return;
      if (!(window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches)) return;
      if (_reviewHoverTimer) return;
      _reviewHoverTimer = setTimeout(() => { _reviewHoverTimer = null; }, 50);
      const feat = findReviewProvinceAt(e.latlng);
      const name = feat ? provinceNameFromFeature(feat) : null;
      if (name === _reviewHoverName) return;
      _reviewHoverName = name;
      if (name) {
        revealReviewProvince(name); // focus only, no zoom
      } else {
        // Mouse left the border → hide focus name again
        clearReviewFocusLabel();
      }
    }

    function bindReviewMapPointerEvents() {
      if (!mapReview) return;
      mapReview.off("click");
      mapReview.off("mousemove");
      mapReview.off("zoomend");
      mapReview.on("click", onReviewMapClick);
      mapReview.on("mousemove", onReviewMapMouseMove);
      mapReview.on("zoomend", () => {
        syncReviewLabelsByZoom();
        // Region chips when zoomed out on an island
        if (!reviewHideAllNames) refreshReviewPickMarkers();
      });
    }

    function isWholePhBounds(b) {
      if (!b) return false;
      if (b === PH_BOUNDS) return true;
      try {
        return Math.abs(b[0][0] - PH_BOUNDS[0][0]) < 0.3 &&
               Math.abs(b[1][0] - PH_BOUNDS[1][0]) < 0.3 &&
               Math.abs(b[0][1] - PH_BOUNDS[0][1]) < 0.5 &&
               Math.abs(b[1][1] - PH_BOUNDS[1][1]) < 0.5;
      } catch (e) { return false; }
    }

    function onHideAllNamesChange(checked) {
      reviewHideAllNames = !!checked;
      clearReviewFocusLabel();
      if (reviewHideAllNames) {
        clearReviewLabelsOnly();
        clearReviewPickMarkers();
        const bar = document.getElementById("map-island-overlay");
        if (bar) bar.style.display = "none";
        document.getElementById("review-hint").textContent =
          "All names hidden · hover/tap a border for one name (hides when you leave)";
      } else {
        const bar = document.getElementById("map-island-overlay");
        if (bar) bar.style.display = "";
        syncReviewLabelsByZoom();
        refreshReviewPickMarkers();
        setReviewIslandButtons(reviewActiveIsland || null);
        if (reviewShowingRegion && currentCode) {
          document.getElementById("review-hint").textContent =
            "Zoom in for province names · hover/tap to focus · empty map zooms back";
        } else if (reviewActiveIsland) {
          document.getElementById("review-hint").textContent =
            "Tap a region · zoom in for province names · empty ocean zooms back";
        } else {
          document.getElementById("review-hint").textContent =
            "Tap Luzon / Visayas / Mindanao · other islands dim · then pick a region";
        }
      }
    }
    // Keep old name as alias for any leftover HTML/handlers
    function onShowAllNamesChange(checked) { onHideAllNamesChange(checked); }
    window.onHideAllNamesChange = onHideAllNamesChange;
    window.onShowAllNamesChange = onShowAllNamesChange;

    function showIslandOnReview(label, opts) {
      const grp = getGroupByLabel(label);
      if (!grp) return;
      reviewActiveIsland = label;
      reviewShowingRegion = false;
      currentCode = null;
      syncHideNamesCheckbox();
      setReviewIslandButtons(label);
      document.getElementById("review-title").textContent = "All " + label;
      document.getElementById("quiz-title").textContent = "All " + label;
      document.getElementById("review-hint").textContent =
        "Tap a region on the map · other islands dim · empty ocean zooms back";
      if (reviewQuizAllowed) {
        document.getElementById("btn-start-quiz").style.display = "inline-block";
      }
      openReviewIslandPanel(label);
      const alreadyReview = document.getElementById("screen-review") &&
        document.getElementById("screen-review").classList.contains("active");
      if (!alreadyReview) show("review");
      const useSmooth = !!(opts && opts.smooth !== false) && !!mapReview;
      const bounds = getIslandBounds(label);
      // Island view: region chips only (no province names)
      setTimeout(() => {
        initReviewMap(bounds, [], false, {
          smooth: useSmooth,
          showLabels: false,
          islandMode: true
        });
        // Re-place region chips after camera settles
        setTimeout(() => {
          if (!reviewHideAllNames && reviewActiveIsland === label && !reviewShowingRegion) {
            placeRegionPickMarkers(label, null);
          }
        }, useSmooth ? 950 : 250);
      }, useSmooth ? 20 : 50);
    }

    function toggleReviewIsland(label) {
      // Same island again:
      // - region view → back to All <island>
      // - already All <island> → zoom back to whole PH
      if (reviewActiveIsland === label && !reviewShowingRegion) {
        onReviewEmptyClick();
        return;
      }
      if (reviewActiveIsland === label && reviewShowingRegion) {
        showIslandOnReview(label, { smooth: true });
        return;
      }
      // Different / first island → focus + dim others + region chips on map
      showIslandOnReview(label, { smooth: true });
    }

    function jumpToReviewRegion(code) {
      if (!REGIONS[code]) return;
      currentCode = code;
      reviewShowingRegion = true;
      syncHideNamesCheckbox();
      const owner = GROUPS.find(g => g.codes.includes(code));
      if (owner) reviewActiveIsland = owner.label;
      const title = `${code} - ${REGIONS[code].name}`;
      document.getElementById("review-title").textContent = title;
      document.getElementById("quiz-title").textContent = title;
      document.getElementById("review-hint").textContent = reviewHideAllNames
        ? "All names hidden · hover/tap a border for one name (hides when you leave)"
        : "Province names on map · hover/tap to focus · empty map zooms back";
      if (reviewQuizAllowed) {
        document.getElementById("btn-start-quiz").style.display = "inline-block";
      }
      if (owner) openReviewIslandPanel(owner.label);
      updateReviewNavButtons();
      const alreadyReview = document.getElementById("screen-review") &&
        document.getElementById("screen-review").classList.contains("active");
      if (!alreadyReview) show("review");
      const useSmooth = !!mapReview;
      const regionItems = reviewHideAllNames ? [] : getItemsForCode(code);
      setTimeout(() => {
        initReviewMap(getBoundsForCode(code), regionItems, false, {
          smooth: useSmooth,
          showLabels: !reviewHideAllNames
        });
        // Ensure labels after camera settles
        setTimeout(() => syncReviewLabelsByZoom(), useSmooth ? 900 : 200);
      }, useSmooth ? 20 : 50);
    }

    function startRegion(code, opts) {
      const wantSmooth = !!(opts && opts.smooth) && !!mapReview &&
        document.getElementById("screen-review") &&
        document.getElementById("screen-review").classList.contains("active");

      // Already on review with a live map → smooth camera transition
      if (wantSmooth && code) {
        transitionToRegion(code, { smooth: true });
        return;
      }

      currentCode = code;
      reviewQuizAllowed = true;
      syncHideNamesCheckbox();
      closeReviewIslandPanel();
      const title = code ? `${code} - ${REGIONS[code].name}` : "Whole Philippines Map";
      document.getElementById("review-title").textContent = title;
      document.getElementById("quiz-title").textContent = title;
      if (code) {
        reviewShowingRegion = true;
        const owner = GROUPS.find(g => g.codes.includes(code));
        reviewActiveIsland = owner ? owner.label : null;
        document.getElementById("review-hint").textContent = reviewHideAllNames
          ? "All names hidden · hover/tap a border for one name (hides when you leave)"
          : "Province names on map · hover/tap to focus · empty map zooms back";
        if (owner) setReviewIslandButtons(owner.label);
      } else {
        reviewShowingRegion = false;
        reviewActiveIsland = null;
        document.getElementById("review-hint").textContent = reviewHideAllNames
          ? "All names hidden · uncheck to restore"
          : "Tap Luzon / Visayas / Mindanao · other islands dim · then pick a region";
        setReviewIslandButtons(null);
      }
      document.getElementById("btn-start-quiz").style.display = "inline-block";
      document.getElementById("btn-review-back").onclick = backToSelect;
      window.__reviewBackFn = backToSelect;
      updateReviewNavButtons();
      show("review");
      if (code) resolveGeo(code).catch(() => {});
      const smoothFirst = !!(opts && opts.smooth);
      const regionItems = (code && !reviewHideAllNames) ? getItemsForCode(code) : [];
      setTimeout(() => {
        initReviewMap(getBoundsForCode(code), regionItems, !code, {
          showLabels: !!(code && !reviewHideAllNames),
          smooth: false
        });
        if (code && !reviewHideAllNames) {
          setTimeout(() => syncReviewLabelsByZoom(), 200);
        }
      }, 50);
      // Soft fade-in of map container on first paint
      if (smoothFirst) {
        const wrap = document.getElementById("map-review-wrap") || document.getElementById("map-review");
        if (wrap) {
          wrap.style.opacity = "0";
          wrap.style.transition = "opacity 0.45s ease";
          requestAnimationFrame(() => {
            requestAnimationFrame(() => { wrap.style.opacity = "1"; });
          });
          setTimeout(() => { wrap.style.transition = ""; }, 500);
        }
      }
    }

    function reviewAllProvinces() {
      appMode = "pin";
      currentCode = null;
      reviewQuizAllowed = false;
      reviewActiveIsland = null;
      reviewShowingRegion = false;
      syncHideNamesCheckbox();
      closeReviewIslandPanel();
      setReviewIslandButtons(null);
      document.getElementById("review-title").textContent = "Whole Philippines Map";
      document.getElementById("review-hint").textContent = reviewHideAllNames
        ? "Names hidden · uncheck “Hide all names” to show them again"
        : "Tap Luzon / Visayas / Mindanao · other islands dim · then pick a region";
      document.getElementById("btn-start-quiz").style.display = "none";
      document.getElementById("btn-review-back").onclick = goHome;
      window.__reviewBackFn = goHome;
      updateReviewNavButtons();
      show("review");
      // Default: borders only, no province names until island or Show all
      setTimeout(() => initReviewMap(PH_BOUNDS, [], true, { showLabels: false }), 50);
    }

    function backToSelect() {
      killAllTimers();
      try { clearAllQuizMarks(); } catch (_) {}
      cleanupMaps();
      answered = false;
      if (appMode === "marathon" && typeof resetMarathonState === "function") {
        resetMarathonState();
      }
      closeReviewIslandPanel();
      try { closeSurprisePicker(); } catch (_) {}
      ["type-panel", "guess-region-panel", "marathon-panel"].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = "none";
      });
      const fb = document.getElementById("marathon-feedback");
      if (fb) { fb.textContent = ""; fb.className = ""; }
      if (appMode === "marathon") {
        appMode = "pin";
        quizState.mode = "pin";
        show("home");
        return;
      }
      // Re-enter select UI for current mode (difficulty panel for guess_region)
      if (appMode === "guess_region") {
        enterMode("guess_region");
        return;
      }
      show("select");
    }

    function goReview() {
      // Leaving quiz mid-run: pause/stop timer so it doesn't keep ticking
      stopTimer();
      stopCountdown();
      clearAutoNext();
      const badge = document.getElementById("timer-badge");
      if (badge) badge.style.display = "none";
      reviewQuizAllowed = true;
      closeReviewIslandPanel();
      const title = currentCode
        ? `${currentCode} - ${REGIONS[currentCode].name}`
        : "Whole Philippines Map";
      document.getElementById("review-title").textContent = title;
      document.getElementById("btn-start-quiz").style.display = "inline-block";
      const reviewBackFromQuiz = () => {
        // Returning from review opened mid-quiz should go back to quiz
        show("quiz");
      };
      document.getElementById("btn-review-back").onclick = reviewBackFromQuiz;
      window.__reviewBackFn = reviewBackFromQuiz;
      if (currentCode) {
        reviewShowingRegion = true;
        syncHideNamesCheckbox();
        const owner = GROUPS.find(g => g.codes.includes(currentCode));
        reviewActiveIsland = owner ? owner.label : null;
        if (owner) setReviewIslandButtons(owner.label);
        document.getElementById("review-hint").textContent = reviewHideAllNames
          ? "Names hidden · hover or tap a border to show one · uncheck to show all"
          : "Tap a province or capital on the map · empty map zooms back";
        show("review");
        const items = reviewHideAllNames ? [] : getItemsForCode(currentCode);
        setTimeout(() => {
          initReviewMap(getBoundsForCode(currentCode), items, false, {
            showLabels: !reviewHideAllNames
          });
          setTimeout(() => syncReviewLabelsByZoom(), 250);
        }, 50);
      } else {
        reviewShowingRegion = false;
        reviewActiveIsland = null;
        syncHideNamesCheckbox();
        setReviewIslandButtons(null);
        document.getElementById("review-hint").textContent = reviewHideAllNames
          ? "All names hidden · uncheck to restore"
          : "Tap Luzon / Visayas / Mindanao · other islands dim · then pick a region";
        show("review");
        setTimeout(() => initReviewMap(PH_BOUNDS, [], true, {
          showLabels: false
        }), 50);
      }
    }

    function shuffle(a) {
      const x = [...a];
      for (let i = x.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [x[i], x[j]] = [x[j], x[i]];
      }
      return x;
    }

    function startQuiz() {
      if (appMode === "marathon") {
        startMarathon();
        return;
      }

      if (appMode === "guess_region") {
        queue = prepareGuessRegionQueue();
      } else {
        const items = getItemsForCode(currentCode);
        let withMode = items.map(it => {
          // NCR cities etc.: province name === capital → never ask "type the capital of X"
          if (isCityUnit(it)) {
            return { ...it, mode: "city" };
          }
          return {
            ...it,
            mode: Math.random() < 0.5 ? "province" : "capital"
          };
        });
        // Always shuffle so order isn't alphabetical / patterned
        queue = shuffle(withMode);
      }
      idx = 0;
      score = 0;
      missed = [];
      markers = [];
      keptMarkers = [];
      clearAutoNext();
      document.getElementById("q-total").textContent = queue.length;
      setModePanelsVisible();
      // Choices are rebuilt per question in showGuessRegionQ
      const mapEl = document.getElementById("map");
      const quizScreen = document.getElementById("screen-quiz");
      if (appMode === "guess_region") {
        if (mapEl) mapEl.style.display = "none";
        if (quizScreen) quizScreen.classList.add("guess-flashcard");
      } else {
        if (mapEl) mapEl.style.display = "block";
        if (quizScreen) quizScreen.classList.remove("guess-flashcard");
      }
      updateQuizNavButtons();
      show("quiz");
      setTimeout(() => {
        if (appMode !== "guess_region") {
          initMap(getBoundsForCode(currentCode));
          if (appMode === "type" && map) {
            map.getContainer().style.cursor = "default";
          }
        } else {
          // No map for flashcard mode — free any previous map instance
          try { if (typeof cleanupMaps === "function") { /* keep other maps */ } } catch (_) {}
        }
        if (playStyle === "speedrun" && (appMode === "pin" || appMode === "type" || appMode === "guess_region")) {
          const secs = (speedrunCarrySeconds != null && speedrunCarrySeconds > 0)
            ? speedrunCarrySeconds
            : getSpeedrunSeconds();
          speedrunCarrySeconds = null;
          startTimer(secs);
        } else {
          speedrunCarrySeconds = null;
          stopTimer();
          const tb = document.getElementById("timer-badge");
          if (tb) tb.style.display = "none";
        }
        showQ();
      }, 50);
    }

    function restart() {
      if (appMode === "marathon") {
        startMarathon();
        return;
      }
      if (playStyle === "speedrun") runCountdown(() => startQuiz());
      else startQuiz();
    }

    /** Reset current region quiz (not available in speedrun). */
    function resetCurrentQuiz() {
      if (playStyle === "speedrun") return;
      sfxClick();
      clearAutoNext();
      stopTimer();
      clearAllQuizMarks();
      startQuiz();
    }

    function goNextRegionFromQuiz() {
      if (playStyle === "speedrun") return;
      goNextRegion();
    }

    /**
     * Show chronological Next region / Next island.
     * Review screen: always show when a region is selected (even in speedrun) - user can skip before starting.
     * Quiz screen: hide in speedrun (timer + auto-next handle flow).
     * Results: handled separately in showResults.
     */
    function applyNextRegionButton(btnId, opts) {
      const nextBtn = document.getElementById(btnId);
      if (!nextBtn) return;
      const forceShow = opts && opts.forceShow;
      // On quiz actions only: hide next during speedrun
      if (!forceShow && playStyle === "speedrun" && btnId === "btn-quiz-next-region") {
        nextBtn.style.display = "none";
        return;
      }
      if (!currentCode) {
        nextBtn.style.display = "none";
        return;
      }
      const info = typeof getNextNavInfo === "function" ? getNextNavInfo() : null;
      if (info && info.code) {
        nextBtn.style.display = "inline-block";
        nextBtn.textContent = info.isNextIsland
          ? ("Next island → " + (info.nextIsland || info.label))
          : ("Next region → " + info.code);
      } else {
        nextBtn.style.display = "none";
      }
    }

    function updateQuizNavButtons() {
      const resetBtn = document.getElementById("btn-quiz-reset");
      if (resetBtn) {
        resetBtn.style.display = playStyle === "speedrun" ? "none" : "inline-block";
      }
      // Guess flashcard: no region hopping / review map
      if (appMode === "guess_region") {
        const nextR = document.getElementById("btn-quiz-next-region");
        if (nextR) nextR.style.display = "none";
        const actions = document.getElementById("quiz-actions");
        if (actions) {
          actions.querySelectorAll("button").forEach(btn => {
            const oc = btn.getAttribute("onclick") || "";
            if (oc.includes("goReview")) btn.style.display = "none";
            if (oc.includes("backToSelect")) {
              btn.textContent = "← Change difficulty";
              btn.style.display = "";
            }
          });
        }
        return;
      }
      const actions = document.getElementById("quiz-actions");
      if (actions) {
        actions.querySelectorAll("button").forEach(btn => {
          const oc = btn.getAttribute("onclick") || "";
          if (oc.includes("goReview")) btn.style.display = "";
          if (oc.includes("backToSelect")) {
            btn.textContent = "← Change region";
          }
        });
      }
      applyNextRegionButton("btn-quiz-next-region");
    }

    function updateReviewNavButtons() {
      // Always show on review when region is active (chronological next / next island)
      applyNextRegionButton("btn-review-next-region", { forceShow: true });
    }

    function topoToGeo(code) {
      if (code === "NCR" && typeof NCR_CITIES_GEO !== "undefined") return NCR_CITIES_GEO;
      const topo = window.PH_TOPO && window.PH_TOPO[code];
      if (!topo) return null;
      const key = Object.keys(topo.objects)[0];
      return topojson.feature(topo, topo.objects[key]);
    }

    function borderStyle(weight) {
      return {
        color: "#ffffff",
        weight: weight || 1.55,
        opacity: 0.95,
        fillColor: "#ffffff",
        fillOpacity: 0.04
      };
    }

    /** Dimmed style for islands that are not the active focus */
    function dimmedBorderStyle(weight) {
      return {
        color: "#2a2a2a",
        weight: weight || 0.7,
        opacity: 0.22,
        fillColor: "#0c0c0c",
        fillOpacity: 0.72
      };
    }

    function activeIslandBorderStyle(weight) {
      return {
        color: "#ffffff",
        weight: weight || 1.85,
        opacity: 1,
        fillColor: "#ffffff",
        fillOpacity: 0.08
      };
    }

    function answeredBorderStyle(correct) {
      if (correct) {
        return {
          color: "#22c55e",
          weight: 3.1,
          opacity: 1,
          fillColor: "#22c55e",
          fillOpacity: 0.32
        };
      }
      return {
        color: "#f59e0b",
        weight: 2.8,
        opacity: 1,
        fillColor: "#f59e0b",
        fillOpacity: 0.22
      };
    }

    /** Bright distinct highlight for the ONE city being asked (before answer) */
    function targetHintBorderStyle() {
      return {
        color: "#fbbf24",
        weight: 3.4,
        opacity: 1,
        fillColor: "#f59e0b",
        fillOpacity: 0.42
      };
    }

    /** Other cities stay white — only the target gets orange highlight */
    function otherCityDimStyle() {
      return borderStyle(1.35);
    }

    /** Set when type-city Q is shown before borders finish loading */
    let pendingTargetHighlight = null;

    function styleQuizBordersHighlightTarget(targetProvince) {
      if (!targetProvince) return;
      pendingTargetHighlight = targetProvince;
      if (!borderLayer) return;
      let found = false;
      const apply = (lyr) => {
        if (!lyr || !lyr.feature || !lyr.setStyle) return;
        const match = featureMatchesProvince(lyr.feature.properties, targetProvince);
        if (match) {
          found = true;
          lyr.setStyle(targetHintBorderStyle());
          if (lyr.bringToFront) try { lyr.bringToFront(); } catch (e) {}
        } else {
          const inQuizRegion = quizFeatures && quizFeatures.some(f => f === lyr.feature);
          if (inQuizRegion) lyr.setStyle(otherCityDimStyle());
          else lyr.setStyle(dimmedBorderStyle(0.7));
        }
      };
      if (borderLayer.eachLayer) {
        borderLayer.eachLayer(lyr => {
          if (lyr.feature) apply(lyr);
          else if (lyr.eachLayer) lyr.eachLayer(apply);
        });
      }
      return found;
    }

    function applyPendingTargetHighlight() {
      if (!pendingTargetHighlight) return;
      styleQuizBordersHighlightTarget(pendingTargetHighlight);
    }

    function makeTileLayer() {
      return L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
        maxZoom: 19,
        attribution: ""
      });
    }

    function mapOptions() {
      // Keep camera inside the Philippines - no drifting to other countries
      const pad = 1.2;
      const maxBounds = L.latLngBounds(
        [PH_BOUNDS[0][0] - pad, PH_BOUNDS[0][1] - pad],
        [PH_BOUNDS[1][0] + pad, PH_BOUNDS[1][1] + pad]
      );
      return {
        zoomControl: false,
        attributionControl: false,
        minZoom: 5.2,
        maxZoom: 14,
        maxBounds,
        maxBoundsViscosity: 0.95,
        bounceAtZoomLimits: true
      };
    }

    /** Desktop PC only (not Android/phone). Used for map fit/zoom. */
    function isDesktopPC() {
      try {
        return !!(window.matchMedia &&
          window.matchMedia("(hover: hover) and (pointer: fine) and (min-width: 900px)").matches);
      } catch (e) {
        return false;
      }
    }

    /** Fit bounds - whole PH fills the frame; regions moderate (not extreme). */
    function fitMapBounds(mapInst, bounds, animate) {
      if (!mapInst || !bounds) return;
      const pc = isDesktopPC();
      const isWhole = bounds === PH_BOUNDS ||
        (bounds && bounds[0] && Math.abs(bounds[0][0] - PH_BOUNDS[0][0]) < 0.25 &&
         Math.abs(bounds[1][0] - PH_BOUNDS[1][0]) < 0.25);
      // Whole PH: small padding so PH fills frame like the target screenshot
      const pad = isWhole
        ? (pc ? [12, 14] : [8, 8])
        : (pc ? [36, 40] : [18, 18]);
      const opts = { padding: pad, animate: !!animate };
      if (isWhole) opts.maxZoom = pc ? 7.8 : 7.4;
      else opts.maxZoom = pc ? 10.5 : 10;
      mapInst.fitBounds(bounds, opts);
    }

    function cleanupMaps() {
      cancelReviewTransition();
      if (map) { map.remove(); map = null; borderLayer = null; }
      if (mapReview) { mapReview.remove(); mapReview = null; borderLayerReview = null; }
      quizFeatures = [];
      markers = [];
      keptMarkers = [];
      reviewMarkers = [];
    }

    function makeLabelHtml(it, small) {
      // Always include capital
      const cls = small ? "label-marker label-sm" : "label-marker";
      return `<div class="${cls}">${it.p}<div class="cap">${it.c}</div></div>`;
    }

    let reviewFocusIdx = -1;
    let reviewDefaultBounds = null;

    let reviewClickLocked = false;
    let reviewLockedIdx = -1;
    let reviewHoverIdx = -1;


    function reviewHighlightStyle() {
      return {
        color: "#f5f5f5",
        weight: 2.6,
        opacity: 1,
        fillColor: "#e8e8e8",
        fillOpacity: 0.28
      };
    }
    function reviewDimProvinceStyle() {
      return {
        color: "#3a3a3a",
        weight: 0.9,
        opacity: 0.35,
        fillColor: "#121212",
        fillOpacity: 0.62
      };
    }
    function reviewNeutralProvinceStyle() {
      return {
        color: "#b0b0b0",
        weight: 1.35,
        opacity: 0.9,
        fillColor: "#7a7a7a",
        fillOpacity: 0.1
      };
    }

    /** Highlight province border on review map when label is focused */
    function styleReviewProvinceFocus(provinceName) {
      if (!mapReview) return;
      const walk = (layer) => {
        if (!layer) return;
        if (layer.eachLayer) {
          layer.eachLayer(walk);
          return;
        }
        if (!layer.feature || !layer.setStyle) return;
        const props = layer.feature.properties || {};
        if (provinceName && featureMatchesProvince(props, provinceName)) {
          layer.setStyle(reviewHighlightStyle());
          if (layer.bringToFront) try { layer.bringToFront(); } catch (e) {}
        } else if (provinceName) {
          layer.setStyle(reviewDimProvinceStyle());
        } else {
          const island = reviewActiveIsland || codeToIsland(currentCode);
          if (reviewActiveIsland && !reviewShowingRegion) {
            const code = layer._phCode;
            if (island && code && codeToIsland(code) && codeToIsland(code) !== island) {
              layer.setStyle(dimmedBorderStyle(0.75));
            } else {
              layer.setStyle(activeIslandBorderStyle(1.35));
            }
          } else {
            layer.setStyle(reviewNeutralProvinceStyle());
          }
        }
      };
      if (borderLayerReview) walk(borderLayerReview);
      if (typeof reviewBorderByCode !== "undefined" && reviewBorderByCode) {
        Object.keys(reviewBorderByCode).forEach(code => {
          const lyr = reviewBorderByCode[code];
          if (lyr) {
            lyr._phCode = code;
            walk(lyr);
          }
        });
      }
    }

    function setReviewFocus(activeIdx, opts) {
      const fromHover = opts && opts.hover;
      if (!fromHover) {
        reviewClickLocked = activeIdx >= 0;
        reviewLockedIdx = activeIdx;
      }
      reviewFocusIdx = activeIdx;
      reviewMarkers.forEach((m, i) => {
        const el = m.getElement && m.getElement();
        if (!el) return;
        const label = el.querySelector(".label-marker");
        if (!label) return;
        label.classList.remove("label-focus", "label-dim");
        if (activeIdx < 0) {
          label.style.opacity = "1";
          label.style.filter = "none";
          label.style.transform = "translateX(-50%) scale(1)";
          label.style.zIndex = "";
          if (m.setZIndexOffset) m.setZIndexOffset(0);
        } else if (i === activeIdx) {
          label.style.opacity = "1";
          label.style.filter = "none";
          label.style.transform = "translateX(-50%) scale(1.22)";
          label.style.zIndex = "40";
          label.classList.add("label-focus");
          if (m.setZIndexOffset) m.setZIndexOffset(1000);
        } else {
          label.style.opacity = "0.26";
          label.style.filter = "saturate(0.45) brightness(0.9)";
          label.style.transform = "translateX(-50%) scale(0.92)";
          label.style.zIndex = "1";
          label.classList.add("label-dim");
          if (m.setZIndexOffset) m.setZIndexOffset(0);
        }
      });
      // Border highlight for focused province / capital
      if (activeIdx >= 0 && reviewMarkers[activeIdx] && reviewMarkers[activeIdx]._phItem) {
        styleReviewProvinceFocus(reviewMarkers[activeIdx]._phItem.p);
      } else if (activeIdx < 0 && !fromHover) {
        styleReviewProvinceFocus(null);
      } else if (activeIdx < 0 && fromHover && reviewClickLocked && reviewLockedIdx >= 0 &&
                 reviewMarkers[reviewLockedIdx] && reviewMarkers[reviewLockedIdx]._phItem) {
        styleReviewProvinceFocus(reviewMarkers[reviewLockedIdx]._phItem.p);
      } else if (activeIdx < 0) {
        styleReviewProvinceFocus(null);
      }
    }

    function resetReviewView() {
      reviewClickLocked = false;
      reviewLockedIdx = -1;
      reviewHoverIdx = -1;
      setReviewFocus(-1);
      styleReviewProvinceFocus(null);
      if (mapReview && reviewDefaultBounds) {
        const pc = isDesktopPC();
        mapReview.flyToBounds(reviewDefaultBounds, {
          padding: pc ? [36, 40] : [16, 16],
          maxZoom: pc ? 10.5 : 10,
          duration: 0.75,
          easeLinearity: 0.28
        });
      }
    }

    /**
     * Empty-map / ocean click → step back one level:
     * province focus → region/island frame → island view → whole PH
     */
    function onReviewEmptyClick() {
      if (!mapReview) return;
      // Zoomed into a province label
      if (reviewFocusIdx >= 0 || reviewClickLocked) {
        resetReviewView();
        return;
      }
      // Viewing a single region → back to its island group
      if (reviewShowingRegion && reviewActiveIsland) {
        showIslandOnReview(reviewActiveIsland, { smooth: true });
        return;
      }
      // Viewing an island group → back to whole Philippines
      if (reviewActiveIsland && !reviewShowingRegion) {
        reviewActiveIsland = null;
        reviewShowingRegion = false;
        currentCode = null;
        closeReviewIslandPanel();
        setReviewIslandButtons(null);
        document.getElementById("review-title").textContent = "Whole Philippines Map";
        document.getElementById("review-hint").textContent =
          "Tap Luzon / Visayas / Mindanao · other islands dim · then pick a region";
        if (!reviewQuizAllowed) {
          document.getElementById("btn-start-quiz").style.display = "none";
        }
        updateReviewNavButtons();
        const items = getReviewLabelItems(getAllItems(null));
        setTimeout(() => initReviewMap(PH_BOUNDS, items, true, {
          smooth: true,
          showLabels: !reviewHideAllNames && items.length > 0
        }), 20);
        return;
      }
      // Already whole PH - mild re-center only if user panned away
      if (mapReview && reviewDefaultBounds && isWholePhBounds(reviewDefaultBounds)) {
        const c = mapReview.getCenter();
        const midLat = (PH_BOUNDS[0][0] + PH_BOUNDS[1][0]) / 2;
        const midLng = (PH_BOUNDS[0][1] + PH_BOUNDS[1][1]) / 2;
        if (Math.abs(c.lat - midLat) > 1.2 || Math.abs(c.lng - midLng) > 1.5) {
          flyReviewToBounds(PH_BOUNDS, 0.7);
        }
      }
    }

    let reviewTransitionId = 0;
    let reviewTransitionTimers = [];

    function cancelReviewTransition() {
      reviewTransitionId++;
      reviewTransitionTimers.forEach(t => clearTimeout(t));
      reviewTransitionTimers = [];
      if (mapReview) {
        try { mapReview.off("moveend"); } catch (e) {}
        try { mapReview.stop(); } catch (e) {}
      }
    }

    function clearReviewPickMarkers() {
      if (reviewPickMarkers && reviewPickMarkers.length) {
        reviewPickMarkers.forEach(m => {
          try { if (mapReview) mapReview.removeLayer(m); } catch (e) {}
        });
      }
      reviewPickMarkers = [];
    }

    function makeMapPickIcon(html) {
      return L.divIcon({
        className: "map-pick-icon",
        html,
        iconSize: [1, 1],
        iconAnchor: [0, 0]
      });
    }

    /** Island picks live in fixed HTML overlay - no geo markers needed. */
    function placeIslandPickMarkers(activeLabel) {
      clearReviewPickMarkers();
      setReviewIslandButtons(activeLabel || null);
    }

    /** Place region buttons on the map for the active island. */
    function placeRegionPickMarkers(islandLabel, activeCode) {
      clearReviewPickMarkers();
      if (!mapReview) return;
      if (reviewHideAllNames) return;
      const grp = getGroupByLabel(islandLabel);
      if (!grp) return;
      setReviewIslandButtons(islandLabel);

      // Inside a single region → hide chips so province names aren't blocked
      if (activeCode || reviewShowingRegion) {
        return;
      }

      grp.codes.forEach(code => {
        const r = REGIONS[code];
        if (!r) return;
        const center = getRegionCenter(code);
        if (!center) return;
        const lat = center[0];
        const lng = center[1];
        const isActive = activeCode === code;
        const shortName = (r.name || "").replace(/Region|Administrative |Autonomous /gi, "").trim();
        const html =
          `<button type="button" class="map-pick-btn region-pick${isActive ? " active" : ""}" data-region="${code}">` +
          `<span>${code}</span>` +
          `<span class="sub">${shortName}</span>` +
          `</button>`;
        const icon = L.divIcon({
          className: "map-pick-icon",
          html,
          iconSize: [110, 44],
          iconAnchor: [55, 22]
        });
        const marker = L.marker([lat, lng], {
          icon,
          interactive: true,
          keyboard: false,
          zIndexOffset: isActive ? 850 : 600
        });
        marker.on("click", (e) => {
          if (e && e.originalEvent) {
            L.DomEvent.stopPropagation(e.originalEvent);
            L.DomEvent.preventDefault(e.originalEvent);
          }
          jumpToReviewRegion(code);
        });
        marker.addTo(mapReview);
        reviewPickMarkers.push(marker);
      });
    }

    function refreshReviewPickMarkers() {
      if (!mapReview) return;
      if (reviewShowingRegion && currentCode) {
        const island = reviewActiveIsland || codeToIsland(currentCode);
        if (island) placeRegionPickMarkers(island, currentCode);
        else placeIslandPickMarkers(null);
      } else if (reviewActiveIsland) {
        placeRegionPickMarkers(reviewActiveIsland, null);
      } else {
        placeIslandPickMarkers(null);
      }
    }

    function clearReviewOverlays() {
      // Remove province labels
      if (reviewMarkers && reviewMarkers.length) {
        reviewMarkers.forEach(m => {
          try { if (mapReview) mapReview.removeLayer(m); } catch (e) {}
        });
      }
      reviewMarkers = [];
      clearReviewPickMarkers();
      reviewBorderByCode = {};
      // Remove border layers
      if (mapReview) {
        if (borderLayerReview) {
          try { mapReview.removeLayer(borderLayerReview); } catch (e) {}
          borderLayerReview = null;
        }
        // Strip leftover non-tile layers (GeoJSON / groups)
        const toRemove = [];
        mapReview.eachLayer(layer => {
          if (layer instanceof L.TileLayer) return;
          toRemove.push(layer);
        });
        toRemove.forEach(l => {
          try { mapReview.removeLayer(l); } catch (e) {}
        });
      }
      reviewFocusIdx = -1;
      reviewClickLocked = false;
      reviewHoverIdx = -1;
      reviewLockedIdx = -1;
    }

    function expandBoundsUnion(a, b, padFactor) {
      // Merge two [[sw],[ne]] bounds with mild expansion (avoid extreme pull-back)
      const f = padFactor == null ? 0.22 : padFactor;
      const minLat = Math.min(a[0][0], b[0][0]);
      const minLng = Math.min(a[0][1], b[0][1]);
      const maxLat = Math.max(a[1][0], b[1][0]);
      const maxLng = Math.max(a[1][1], b[1][1]);
      const spanLat = Math.max(maxLat - minLat, 0.6);
      const spanLng = Math.max(maxLng - minLng, 0.6);
      const dLat = spanLat * f;
      const dLng = spanLng * f;
      return [
        [minLat - dLat, minLng - dLng],
        [maxLat + dLat, maxLng + dLng]
      ];
    }

    function fadeReviewLabels(toOpacity, durationMs) {
      (reviewMarkers || []).forEach(m => {
        const el = m.getElement && m.getElement();
        if (el) {
          el.style.transition = `opacity ${durationMs || 280}ms ease`;
          el.style.opacity = String(toOpacity);
        }
        if (m.setOpacity) m.setOpacity(toOpacity);
      });
    }

    function attachReviewMarkers(items, small) {
      reviewMarkers = [];
      reviewClickLocked = false;
      reviewHoverIdx = -1;
      // Spread labels so dense clusters (NCR, nearby provinces) don't cover each other
      const dense = items.length >= 12;
      const spread = spreadLabelPositions(items, {
        minSepKm: dense ? 2.2 : (small ? 4.5 : 3.2),
        iterations: dense ? 36 : 24,
        strength: dense ? 0.7 : 0.55
      });
      spread.forEach((it, i) => {
        const icon = L.divIcon({
          className: "ph-label-icon",
          html: makeLabelHtml(it, small),
          iconSize: undefined,
          iconAnchor: [0, 12]
        });
        const marker = L.marker([it.lat, it.lng], { icon, interactive: true, riseOnHover: true, opacity: 0 }).addTo(mapReview);
        marker._phItem = it;
        marker._origLatLng = L.latLng(it._origLat, it._origLng);
        // Fade labels in
        setTimeout(() => {
          const el = marker.getElement && marker.getElement();
          if (el) {
            el.style.transition = "opacity 0.45s ease";
            el.style.opacity = "1";
          }
          if (marker.setOpacity) marker.setOpacity(1);
        }, 30 + Math.min(i * 8, 200));
        marker.on("click", (e) => {
          if (e.originalEvent) L.DomEvent.stopPropagation(e.originalEvent);
          reviewHoverIdx = i;
          setReviewFocus(i);
          styleReviewProvinceFocus(it.p);
          // Pan to place; auto-zoom capped (manual zoom stays free)
          const flyLat = it._origLat != null ? it._origLat : it.lat;
          const flyLng = it._origLng != null ? it._origLng : it.lng;
          flyReviewToPlace(flyLat, flyLng);
        });
        marker.on("mouseover", () => {
          if (window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches === false) return;
          reviewHoverIdx = i;
          setReviewFocus(i, { hover: true });
        });
        marker.on("mouseout", () => {
          if (window.matchMedia && window.matchMedia("(hover: hover) and (pointer: fine)").matches === false) return;
          if (reviewHoverIdx === i) reviewHoverIdx = -1;
          if (reviewClickLocked && reviewLockedIdx >= 0) {
            setReviewFocus(reviewLockedIdx, { hover: true });
          } else {
            setReviewFocus(-1, { hover: true });
          }
        });
        reviewMarkers.push(marker);
      });
    }

    function loadReviewBorders(loadAll) {
      // Always load full PH borders so surroundings can dim professionally
      // - island focus: active island bright, others dark
      // - region focus: that region bright, rest of PH dark
      if (reviewShowingRegion && currentCode) {
        loadAllBordersOnto(mapReview, reviewActiveIsland || null, currentCode);
      } else if (loadAll || !currentCode || reviewActiveIsland) {
        loadAllBordersOnto(mapReview, reviewActiveIsland || null, null);
      } else {
        loadBordersOnto(mapReview, currentCode, true);
      }
    }

    function flyReviewToBounds(bounds, duration) {
      if (!mapReview || !bounds) return;
      const pc = isDesktopPC();
      const isWhole = bounds === PH_BOUNDS ||
        (bounds && bounds[0] && Math.abs(bounds[0][0] - PH_BOUNDS[0][0]) < 0.25 &&
         Math.abs(bounds[1][0] - PH_BOUNDS[1][0]) < 0.25);
      // Island-sized frames: keep camera on land, not open ocean
      const latSpan = bounds && bounds[0] ? Math.abs(bounds[1][0] - bounds[0][0]) : 15;
      const isIslandFrame = !isWhole && latSpan > 3.5;
      const opts = {
        padding: isWhole
          ? (pc ? [12, 14] : [8, 8])
          : isIslandFrame
            ? (pc ? [28, 32] : [16, 16])
            : (pc ? [36, 40] : [18, 18]),
        duration: duration == null ? 1.05 : duration,
        easeLinearity: 0.18
      };
      opts.maxZoom = isWhole
        ? (pc ? 7.8 : 7.4)
        : isIslandFrame
          ? (pc ? 8.6 : 8.2)
          : (pc ? 10.5 : 10);
      try { mapReview.stop(); } catch (e) {}
      mapReview.flyToBounds(bounds, opts);
    }

    function initReviewMap(bounds, items, loadAll, opts) {
      const wantSmooth = !!(opts && opts.smooth) && !!mapReview;
      let showLabels = !(opts && opts.showLabels === false);
      if (reviewHideAllNames) showLabels = false;
      const islandMode = !!(opts && opts.islandMode);
      const small = !!loadAll || !currentCode || islandMode;
      reviewDefaultBounds = bounds;
      let labelItems = [];
      if (showLabels) {
        // Prefer explicit items passed in; else region pool when a region is open
        if (items && items.length) {
          labelItems = items.slice();
        } else if (reviewShowingRegion && currentCode) {
          labelItems = getReviewLabelItems(getItemsForCode(currentCode));
        }
      }

      if (wantSmooth) {
        // Cancel any in-flight region transition
        cancelReviewTransition();
        const tid = reviewTransitionId;

        // Professional camera: ease out → swap layers → ease into target
        let fromBounds = null;
        try {
          const b = mapReview.getBounds();
          fromBounds = [
            [b.getSouth(), b.getWest()],
            [b.getNorth(), b.getEast()]
          ];
        } catch (e) {
          fromBounds = bounds;
        }
        // Slightly wider mid-frame so the move feels continuous, not abrupt
        const mid = expandBoundsUnion(fromBounds, bounds, 0.28);

        fadeReviewLabels(0, 260);
        // Soft fade on the whole map pane during swap
        try {
          const pane = mapReview.getContainer();
          if (pane) {
            pane.style.transition = "filter 0.35s ease";
            pane.style.filter = "brightness(0.88) saturate(0.85)";
          }
        } catch (e) {}

        // Phase 1 - ease out toward midpoint
        flyReviewToBounds(mid, 0.65);

        let swapped = false;
        const doSwapAndZoomIn = () => {
          if (swapped || tid !== reviewTransitionId || !mapReview) return;
          swapped = true;
          try { mapReview.off("moveend", onMid); } catch (e) {}

          clearReviewOverlays();
          borderLayerReview = null;
          // Island mode still shows all PH borders for context; region shows its borders
          loadReviewBorders(loadAll || islandMode || !currentCode);
          if (labelItems.length) attachReviewMarkers(labelItems, small);
          // Place region picks on the map (if not deep in a region)
          setTimeout(() => refreshReviewPickMarkers(), 80);

          bindReviewMapPointerEvents();

          // Phase 2 - ease into the new region
          const t2 = setTimeout(() => {
            if (tid !== reviewTransitionId || !mapReview) return;
            flyReviewToBounds(bounds, 0.9);
            try {
              const pane = mapReview.getContainer();
              if (pane) {
                pane.style.filter = "none";
                setTimeout(() => { pane.style.transition = ""; }, 400);
              }
            } catch (e) {}
          }, 80);
          reviewTransitionTimers.push(t2);
        };

        const onMid = () => {
          doSwapAndZoomIn();
        };
        mapReview.once("moveend", onMid);
        // Safety fallback if moveend is skipped (interrupted fly)
        const tSafety = setTimeout(doSwapAndZoomIn, 1000);
        reviewTransitionTimers.push(tSafety);
        return;
      }

      // Fresh map (first open / non-smooth)
      cancelReviewTransition();
      if (mapReview) {
        mapReview.remove();
        mapReview = null;
        borderLayerReview = null;
        reviewMarkers = [];
      }
      reviewFocusIdx = -1;
      mapReview = L.map("map-review", mapOptions());
      makeTileLayer().addTo(mapReview);
      fitMapBounds(mapReview, bounds, false);

      loadReviewBorders(loadAll || islandMode || !currentCode);
      if (labelItems.length) attachReviewMarkers(labelItems, small);

      bindReviewMapPointerEvents();
      setTimeout(() => {
        if (!mapReview) return;
        mapReview.invalidateSize();
        fitMapBounds(mapReview, bounds, false);
        refreshReviewPickMarkers();
        setReviewIslandButtons(reviewActiveIsland || null);
      }, 120);
    }

    /**
     * Load all region borders onto review map.
     * @param activeIsland - Luzon/Visayas/Mindanao focus (others dark)
     * @param activeRegionCode - single region focus (that region bright, everything else dark)
     */
    async function loadAllBordersOnto(targetMap, activeIsland, activeRegionCode) {
      const layers = [];
      reviewBorderByCode = {};
      if (borderLayerReview && targetMap) {
        try { targetMap.removeLayer(borderLayerReview); } catch (e) {}
        borderLayerReview = null;
      }
      for (const code of Object.keys(REGION_PSGC)) {
        const geo = await resolveGeo(code);
        if (!geo || !targetMap) continue;
        const island = codeToIsland(code);
        let style;
        if (activeRegionCode) {
          // Region drill-down: selected region bright, surroundings solid dark
          style = (code === activeRegionCode)
            ? activeIslandBorderStyle(1.7)
            : dimmedBorderStyle(0.7);
        } else if (!activeIsland) {
          style = borderStyle(1.05);
        } else if (island === activeIsland) {
          style = activeIslandBorderStyle(1.55);
        } else {
          style = dimmedBorderStyle(0.7);
        }
        const layer = L.geoJSON(geo, {
          style,
          interactive: false
        }).addTo(targetMap);
        layer._phCode = code;
        layer._phIsland = island;
        reviewBorderByCode[code] = layer;
        layers.push(layer);
      }
      borderLayerReview = L.layerGroup(layers);
      applyIslandDimStyle(activeIsland, activeRegionCode);
    }

    function applyIslandDimStyle(activeIsland, activeRegionCode) {
      if (!reviewBorderByCode) return;
      Object.keys(reviewBorderByCode).forEach(code => {
        const layer = reviewBorderByCode[code];
        if (!layer) return;
        const island = codeToIsland(code);
        let style;
        if (activeRegionCode) {
          style = (code === activeRegionCode)
            ? activeIslandBorderStyle(1.7)
            : dimmedBorderStyle(0.7);
        } else if (!activeIsland) {
          style = borderStyle(1.05);
        } else if (island === activeIsland) {
          style = activeIslandBorderStyle(1.45);
        } else {
          style = dimmedBorderStyle(0.7);
        }
        if (layer.setStyle) layer.setStyle(style);
        else if (layer.eachLayer) layer.eachLayer(l => { if (l.setStyle) l.setStyle(style); });
      });
    }

    function initMap(bounds) {
      if (map) {
        map.remove();
        map = null;
        borderLayer = null;
      }
      map = L.map("map", mapOptions());
      makeTileLayer().addTo(map);
      fitMapBounds(map, bounds, false);
      map.getContainer().style.cursor = appMode === "pin" ? "crosshair" : "default";
      // Prefill quizFeatures from cache immediately so first click isn't empty
      if (currentCode && geoCache[currentCode] && geoCache[currentCode].features) {
        quizFeatures = geoCache[currentCode].features.slice();
      }
      // Region quiz: bright borders for this region, solid dark surroundings
      // Whole PH: all regions normal visible borders
      if (currentCode) loadQuizBordersWithContext(map, currentCode);
      else loadAllBordersForQuiz(map);
      setTimeout(() => {
        map.invalidateSize();
        fitMapBounds(map, bounds, false);
      }, 120);
    }

    /** Cache resolved GeoJSON so quiz clicks never race empty quizFeatures */
    const geoCache = Object.create(null);

    async function resolveGeo(code) {
      if (!code) return null;
      if (geoCache[code]) return geoCache[code];
      if (code === "NCR" && typeof NCR_CITIES_GEO !== "undefined") {
        geoCache[code] = NCR_CITIES_GEO;
        return NCR_CITIES_GEO;
      }
      const local = topoToGeo(code);
      if (local) {
        geoCache[code] = local;
        return local;
      }
      const psgc = REGION_PSGC[code];
      if (!psgc) return null;
      try {
        const url = `https://raw.githubusercontent.com/faeldon/philippines-json-maps/master/2023/topojson/regions/lowres/provdists-region-${psgc}.topo.0.001.json`;
        const res = await fetch(url);
        const topo = await res.json();
        const key = Object.keys(topo.objects)[0];
        const geo = topojson.feature(topo, topo.objects[key]);
        geoCache[code] = geo;
        return geo;
      } catch (e) {
        console.warn("Border fetch failed", code, e);
        return null;
      }
    }

    /** Soft style for non-target provinces after answer — keep white borders, light fill */
    function quizSoftDimStyle() {
      return {
        color: "#ffffff",
        weight: 1.25,
        opacity: 0.85,
        fillColor: "#ffffff",
        fillOpacity: 0.04
      };
    }

    async function loadBordersOnto(targetMap, code, isReview) {
      if (!targetMap || !code) return;
      const prev = isReview ? borderLayerReview : borderLayer;
      if (prev) targetMap.removeLayer(prev);
      const geo = await resolveGeo(code);
      if (!geo) return;
      if (!isReview) quizFeatures = geo.features || [];
      // Quiz region provinces: clear visible borders
      const layer = L.geoJSON(geo, {
        style: borderStyle(1.45),
        interactive: false
      }).addTo(targetMap);
      if (isReview) borderLayerReview = layer;
      else borderLayer = layer;
    }

    /**
     * Quiz with context: active region borders visible,
     * surrounding regions/islands solid dark (like review island focus).
     */
    async function loadQuizBordersWithContext(targetMap, activeCode) {
      if (!targetMap || !activeCode) return;
      if (borderLayer) {
        try { targetMap.removeLayer(borderLayer); } catch (e) {}
        borderLayer = null;
      }
      const layers = [];
      quizFeatures = [];
      for (const code of Object.keys(REGION_PSGC)) {
        const geo = await resolveGeo(code);
        if (!geo || !targetMap) continue;
        const isActive = code === activeCode;
        if (isActive && geo.features) quizFeatures = geo.features.slice();
        const layer = L.geoJSON(geo, {
          style: isActive ? borderStyle(1.5) : dimmedBorderStyle(0.75),
          interactive: false
        }).addTo(targetMap);
        layer._phCode = code;
        layers.push(layer);
      }
      borderLayer = L.layerGroup(layers);
      // Re-apply city highlight if a type-city question is waiting
      applyPendingTargetHighlight();
    }

    async function loadAllBordersForQuiz(targetMap) {
      quizFeatures = [];
      const layers = [];
      for (const code of Object.keys(REGION_PSGC)) {
        const geo = await resolveGeo(code);
        if (!geo) continue;
        if (geo.features) quizFeatures.push(...geo.features);
        layers.push(L.geoJSON(geo, {
          style: borderStyle(1.05),
          interactive: false
        }).addTo(targetMap));
      }
      borderLayer = L.layerGroup(layers);
      applyPendingTargetHighlight();
    }

    /** After an answer: highlight target; soft-dim other provinces in the active region only */
    function styleQuizBordersAfterAnswer(targetProvince, correct) {
      if (!borderLayer) return;
      const apply = (lyr) => {
        if (!lyr || !lyr.feature) return;
        const props = lyr.feature.properties;
        const match = featureMatchesProvince(props, targetProvince);
        if (match) {
          lyr.setStyle(answeredBorderStyle(correct));
          if (lyr.bringToFront) try { lyr.bringToFront(); } catch (e) {}
        } else {
          // Keep surroundings dark; soft-dim only features that are part of quizFeatures (active region)
          const inQuizRegion = quizFeatures && quizFeatures.some(f => f === lyr.feature);
          if (inQuizRegion) lyr.setStyle(quizSoftDimStyle());
          else lyr.setStyle(dimmedBorderStyle(0.75));
        }
      };
      if (borderLayer.eachLayer) {
        borderLayer.eachLayer(lyr => {
          if (lyr.feature) apply(lyr);
          else if (lyr.eachLayer) lyr.eachLayer(apply);
        });
      }
    }

    function pointInRing(lng, lat, ring) {
      let inside = false;
      for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
        const xi = ring[i][0], yi = ring[i][1];
        const xj = ring[j][0], yj = ring[j][1];
        const intersect = ((yi > lat) !== (yj > lat)) &&
          (lng < (xj - xi) * (lat - yi) / (yj - yi + 1e-12) + xi);
        if (intersect) inside = !inside;
      }
      return inside;
    }
    function pointInFeature(lng, lat, feature) {
      if (!feature || !feature.geometry) return false;
      const g = feature.geometry;
      if (g.type === "Polygon") {
        if (!pointInRing(lng, lat, g.coordinates[0])) return false;
        for (let h = 1; h < g.coordinates.length; h++) {
          if (pointInRing(lng, lat, g.coordinates[h])) return false;
        }
        return true;
      }
      if (g.type === "MultiPolygon") {
        for (const poly of g.coordinates) {
          if (!pointInRing(lng, lat, poly[0])) continue;
          let inHole = false;
          for (let h = 1; h < poly.length; h++) {
            if (pointInRing(lng, lat, poly[h])) { inHole = true; break; }
          }
          if (!inHole) return true;
        }
      }
      return false;
    }

    /** Tiny island provinces that are hard to hit on phone */
    const HARD_ISLAND_KM = {
      "batanes": 55,
      "camiguin": 32,
      "siquijor": 30,
      "guimaras": 28,
      "biliran": 30,
      "dinagat islands": 38,
      "catanduanes": 32,
      "marinduque": 30,
      "basilan": 36,
      "sulu": 42,
      "tawi-tawi": 48,
      "romblon": 34,
      "masbate": 28
    };

    function isCoarsePointer() {
      try {
        return !!(window.matchMedia && (
          window.matchMedia("(pointer: coarse)").matches ||
          window.matchMedia("(max-width: 900px)").matches
        ));
      } catch (_) {
        return window.innerWidth <= 900;
      }
    }

    function forEachOuterRing(feature, fn) {
      if (!feature || !feature.geometry) return;
      const g = feature.geometry;
      if (g.type === "Polygon") fn(g.coordinates[0]);
      else if (g.type === "MultiPolygon") {
        for (const poly of g.coordinates) fn(poly[0]);
      }
    }

    /** Approx span of feature in km (diagonal of bbox) */
    function featureSpanKm(feature) {
      let minLng = Infinity, maxLng = -Infinity, minLat = Infinity, maxLat = -Infinity;
      forEachOuterRing(feature, (ring) => {
        for (const pt of ring) {
          const lng = pt[0], lat = pt[1];
          if (lng < minLng) minLng = lng;
          if (lng > maxLng) maxLng = lng;
          if (lat < minLat) minLat = lat;
          if (lat > maxLat) maxLat = lat;
        }
      });
      if (!isFinite(minLng)) return 999;
      return haversine(minLat, minLng, maxLat, maxLng);
    }

    /** Min distance from click to any outer-ring edge (km), using point-to-segment */
    function minDistToFeatureKm(lng, lat, feature) {
      let min = Infinity;
      forEachOuterRing(feature, (ring) => {
        if (!ring || ring.length < 2) return;
        for (let i = 0; i < ring.length; i++) {
          const [x1, y1] = ring[i];
          const [x2, y2] = ring[(i + 1) % ring.length];
          // Vertex distances
          const d1 = haversine(lat, lng, y1, x1);
          if (d1 < min) min = d1;
          // Closest point on segment in planar approx (good for local PH scale)
          const dx = x2 - x1, dy = y2 - y1;
          const len2 = dx * dx + dy * dy;
          let t = 0;
          if (len2 > 1e-18) {
            t = ((lng - x1) * dx + (lat - y1) * dy) / len2;
            t = Math.max(0, Math.min(1, t));
          }
          const cx = x1 + t * dx;
          const cy = y1 + t * dy;
          const dc = haversine(lat, lng, cy, cx);
          if (dc < min) min = dc;
        }
      });
      return min;
    }

    function getClickToleranceKm(item, feat) {
      const mobile = isCoarsePointer();
      const nameKey = normName(item && item.p);
      if (HARD_ISLAND_KM[nameKey] != null) {
        return HARD_ISLAND_KM[nameKey] * (mobile ? 1.2 : 1.05);
      }
      // Extra soft edge for long/narrow Visayas provinces (Samar, Leyte, etc.)
      // Low-res topo often puts coastline clicks just outside the polygon.
      const VISAYAS_SOFT = {
        "samar": mobile ? 28 : 18,
        "northern samar": mobile ? 28 : 18,
        "eastern samar": mobile ? 28 : 18,
        "leyte": mobile ? 26 : 16,
        "southern leyte": mobile ? 24 : 16,
        "cebu": mobile ? 22 : 14,
        "bohol": mobile ? 22 : 14,
        "negros oriental": mobile ? 22 : 14,
        "negros occidental": mobile ? 22 : 14,
        "iloilo": mobile ? 20 : 13,
        "antique": mobile ? 20 : 13,
        "capiz": mobile ? 20 : 13,
        "aklan": mobile ? 20 : 13,
        "guimaras": mobile ? 24 : 16,
        "biliran": mobile ? 24 : 16,
        "siquijor": mobile ? 24 : 16
      };
      if (VISAYAS_SOFT[nameKey] != null) return VISAYAS_SOFT[nameKey];
      if (feat) {
        const span = featureSpanKm(feat);
        // Small provinces / islands: generous soft edge
        if (span < 35) return mobile ? 40 : 28;
        if (span < 60) return mobile ? 30 : 20;
        if (span < 100) return mobile ? 20 : 14;
        if (span < 160) return mobile ? 16 : 10;
      }
      // Mainland: light finger-fat tolerance only on phone
      return mobile ? 14 : 8;
    }

    /** Find which loaded quiz feature (if any) contains the click. Prefer exact match order. */
    function findFeatureContainingPoint(lng, lat) {
      if (!quizFeatures || !quizFeatures.length) return null;
      for (const f of quizFeatures) {
        if (pointInFeature(lng, lat, f)) return f;
      }
      return null;
    }

    function isClickCorrectForProvince(clickLng, clickLat, feat, item) {
      // 1) Strict point-in-polygon on the matched target feature
      if (feat && pointInFeature(clickLng, clickLat, feat)) return true;

      // 2) Reverse lookup: which drawn province contains the click?
      //    If it's clearly inside ANOTHER province → wrong (don't soft-edge across).
      //    If it's inside the target (name match) → correct even if findFeature mismatched.
      const containing = findFeatureContainingPoint(clickLng, clickLat);
      if (containing) {
        if (featureMatchesProvince(containing.properties, item.p) || containing === feat) {
          return true;
        }
        // Inside a different province's polygon → hard miss
        return false;
      }

      const tol = getClickToleranceKm(item, feat);
      // 3) Soft edge: only when not inside any province polygon (near border / sea / sparse topo)
      //    Require target to be the nearest feature so we don't steal neighbors.
      if (feat) {
        const edgeDist = minDistToFeatureKm(clickLng, clickLat, feat);
        if (edgeDist <= tol) {
          let nearestOther = Infinity;
          if (quizFeatures && quizFeatures.length) {
            for (const f of quizFeatures) {
              if (f === feat) continue;
              if (featureMatchesProvince(f.properties, item.p)) continue;
              const d = minDistToFeatureKm(clickLng, clickLat, f);
              if (d < nearestOther) nearestOther = d;
            }
          }
          // Accept if target edge is closer (or tied within 2km) than any other province
          if (edgeDist <= nearestOther + 2) return true;
        }
      }
      // 4) Capital / listed centroid fallback (geo missing or very sparse)
      if (item && item.lat != null && item.lng != null) {
        const d = haversine(clickLat, clickLng, item.lat, item.lng);
        const capTol = Math.min(tol, feat ? tol * 0.55 : tol);
        if (d <= capTol) return true;
      }
      return false;
    }
    function normName(s) {
      return (s || "").toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, " ").trim();
    }
    /** Score how well a geo feature name matches a province name (higher = better).
     * Exact match wins. Avoids "Samar" matching "Northern Samar" first. */
    function nameMatchScore(featureName, targetName) {
      const n = normName(featureName);
      const t = normName(targetName);
      if (!n || !t) return 0;
      if (n === t) return 100;
      // "city of X" / "X city"
      if (n === t + " city" || t === n + " city") return 95;
      // Word-boundary: all target words present as whole words in n (or vice versa for longer names)
      const tw = t.split(/\s+/).filter(Boolean);
      const nw = n.split(/\s+/).filter(Boolean);
      if (tw.length && tw.every(w => nw.includes(w)) && Math.abs(nw.length - tw.length) <= 1) return 80;
      // Reject short substring traps: "samar" inside "northern samar" without being equal
      if (n.includes(t) && t.length >= 5 && nw.length === tw.length) return 60;
      if (t.includes(n) && n.length >= 5 && nw.length === tw.length) return 55;
      return 0;
    }

    function findFeatureForProvince(provinceName) {
      const target = normName(provinceName);
      if (!target || !quizFeatures || !quizFeatures.length) return null;
      let best = null;
      let bestScore = 0;
      for (const f of quizFeatures) {
        const raw = (f.properties && (f.properties.adm2_en || f.properties.name || f.properties.NAME_2 || f.properties.province)) || "";
        const sc = nameMatchScore(raw, provinceName);
        if (sc > bestScore) {
          bestScore = sc;
          best = f;
        }
      }
      // Require a solid match (exact or near-exact) - never return a weak partial
      return bestScore >= 55 ? best : null;
    }

    function featureMatchesProvince(props, provinceName) {
      if (!props) return false;
      const raw = props.adm2_en || props.name || props.NAME_2 || props.province || "";
      return nameMatchScore(raw, provinceName) >= 55;
    }

    function clearTempMarkers() {
      markers.forEach(m => map && map.removeLayer(m));
      markers = [];
      if (clickHandler && map) {
        map.off("click", clickHandler);
        clickHandler = null;
      }
    }

    function clearAllQuizMarks() {
      clearTempMarkers();
      keptMarkers.forEach(m => map && map.removeLayer(m));
      keptMarkers = [];
      if (borderLayer && borderLayer.setStyle) {
        borderLayer.setStyle(borderStyle(1.4));
      } else if (borderLayer && borderLayer.eachLayer) {
        borderLayer.eachLayer(l => {
          if (l.setStyle) l.setStyle(borderStyle(1.05));
        });
      }
    }

    function clearAutoNext() {
      if (autoNextTimer) {
        clearTimeout(autoNextTimer);
        autoNextTimer = null;
      }
    }

    function maybeAutoNext(wasCorrect) {
      clearAutoNext();
      if (wasCorrect && settings.autoNext) {
        autoNextTimer = setTimeout(() => nextQ(), 700);
      } else if (!wasCorrect && settings.autoNextWrong) {
        autoNextTimer = setTimeout(() => nextQ(), 1100);
      }
    }

    function resetQuizBordersDim() {
      pendingTargetHighlight = null;
      if (!borderLayer) return;
      const apply = (lyr) => {
        if (!lyr || !lyr.setStyle) return;
        // Active region provinces: normal visible; surroundings stay dark
        const inQuiz = lyr.feature && quizFeatures && quizFeatures.some(f => f === lyr.feature);
        if (inQuiz || (lyr._phCode && lyr._phCode === currentCode)) {
          lyr.setStyle(borderStyle(1.4));
        } else if (lyr._phCode && lyr._phCode !== currentCode) {
          lyr.setStyle(dimmedBorderStyle(0.75));
        } else {
          // GeoJSON child without _phCode - if in quizFeatures set, brighten
          if (lyr.feature && quizFeatures && quizFeatures.indexOf(lyr.feature) >= 0) {
            lyr.setStyle(borderStyle(1.4));
          } else if (currentCode) {
            lyr.setStyle(dimmedBorderStyle(0.75));
          } else {
            lyr.setStyle(borderStyle(1.15));
          }
        }
      };
      if (borderLayer.eachLayer) {
        borderLayer.eachLayer(lyr => {
          if (lyr.feature) apply(lyr);
          else if (lyr.eachLayer) {
            // Region group layer
            if (lyr._phCode && lyr._phCode === currentCode) {
              lyr.eachLayer(c => { if (c.setStyle) c.setStyle(borderStyle(1.4)); });
            } else if (lyr._phCode) {
              lyr.eachLayer(c => { if (c.setStyle) c.setStyle(dimmedBorderStyle(0.75)); });
            } else {
              lyr.eachLayer(apply);
            }
          } else apply(lyr);
        });
      } else if (borderLayer.setStyle) {
        borderLayer.setStyle(borderStyle(1.4));
      }
    }

